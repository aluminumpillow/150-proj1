include "checker.kl";

# Run table-driven assertions using the same IO style as testScope.
letrec forEachTest test items =
  match items {
    [] => pureIO unit;
    first :: rest =>
      do (bindIO) {
        test first;
        forEachTest test rest
      };
  };

# Compare exact results, including error messages and returned record field order.
# Expected results do not use typeEquals, so its bugs cannot hide checkExpr bugs.
let assertExpr label expr typeEnv expected =
  assert label (checkExpr expr typeEnv == expected);

# One expression and type for every Type constructor.
let exprSamples = [
  {label = "number", expr = NumberExpr 1.0, typ = NumberType},
  {label = "boolean", expr = BoolExpr true, typ = BoolType},
  {label = "string", expr = StringExpr "hello", typ = StringType},
  {label = "null", expr = NullExpr, typ = NullType},
  {
    label = "function",
    expr = FnExpr
      [{name = "n", typ = NumberType}, {name = "text", typ = StringType}]
      BoolType
      (BoolExpr true),
    typ = FunctionType [NumberType, StringType] BoolType
  },
  {
    label = "record",
    expr = RecordExpr [
      {name = "count", expr = NumberExpr 1.0},
      {name = "active", expr = BoolExpr true}
    ],
    typ = RecordType [
      {name = "count", typ = NumberType},
      {name = "active", typ = BoolType}
    ]
  }
];

let sampleBindings =
  map (fn sample => {name = sample.label, typ = sample.typ}) exprSamples;

let sampleScope = addBindings emptyScope sampleBindings;
let sampleEnv = [sampleScope];

let scope1 =
  extendScope
    emptyScope
    "x"
    NumberType;

let scope2 =
  extendScope
    scope1
    "flag"
    BoolType;

let scope3 =
  extendScope
    scope2
    "x"
    BoolType;


let testScope: IO Unit =
  do (bindIO) {
    assert "emptyScope has no bindings" (emptyScope "x" == None);
    assert "extendScope binds a type"
      (scope1 "x" == Some NumberType);
    assert "extendScope preserves missing variables"
      (scope1 "missing" == None);
    assert "extendScope preserves old bindings"
      (scope2 "x" == Some NumberType);
    assert "extendScope allows shadowing"
      (scope3 "x" == Some BoolType);
    assert "extendScope preserves unrelated bindings when shadowing"
      (scope3 "flag" == Some BoolType);
    assert "extendScope leaves the original scope unchanged"
      (scope1 "x" == Some NumberType);
    assert "localScope of an empty environment is empty"
      ((localScope []) "x" == None);
    assert "localScope returns the innermost scope"
      ((localScope [scope3, scope1]) "x" == Some BoolType);
    assert "localScope does not search outer scopes"
      ((localScope [emptyScope, scope1]) "x" == None);
    assert "pushScope creates an empty local scope"
      ((localScope (pushScope [scope1])) "x" == None);
    assert "pushScope preserves access to outer bindings"
      (lookup "x" (pushScope [scope1]) == Ok NumberType);
    assert "pushScope works on an empty environment"
      (length (pushScope []) == 1);
    assert "initialTypeEnv contains one empty scope"
      (length initialTypeEnv == 1 && (localScope initialTypeEnv) "x" == None);
    outputLnIO "✅ All passing for scope tests"
  };

let testInArr: IO Unit =
  do (bindIO) {
    assert "inArr: empty list" (not (inArr 1 []));
    assert "inArr: singleton hit" (inArr 1 [1]);
    assert "inArr: singleton miss" (not (inArr 2 [1]));
    assert "inArr: first element" (inArr 1 [1, 2, 3]);
    assert "inArr: middle element" (inArr 2 [1, 2, 3]);
    assert "inArr: last element" (inArr 3 [1, 2, 3]);
    assert "inArr: absent element" (not (inArr 4 [1, 2, 3]));
    assert "inArr: repeated elements" (inArr 2 [2, 2, 2]);
    assert "inArr: miss among repeated elements" (not (inArr 1 [2, 2, 2]));
    assert "inArr: zero and negative numbers" (inArr (-1) [0, -1, 1]);
    assert "inArr: empty string" (inArr "" ["x", ""]);
    assert "inArr: strings are case sensitive" (not (inArr "X" ["x"]));
    assert "inArr: booleans" (inArr false [true, false]);
    assert "inArr: boolean miss" (not (inArr false [true]));
    assert "inArr: structural values"
      (inArr (FunctionType [NumberType] BoolType)
        [NullType, FunctionType [NumberType] BoolType]);
    outputLnIO "✅ All passing for inArr tests"
  };

let testAllUnique: IO Unit =
  do (bindIO) {
    assert "allUnique: no records or seen names" (allUnique [] []);
    assert "allUnique: no records with seen names" (allUnique [] ["used"]);
    assert "allUnique: singleton"
      (allUnique [{name = "x", typ = NumberType}] []);
    assert "allUnique: distinct names may share a type"
      (allUnique [
        {name = "x", typ = NumberType},
        {name = "y", typ = NumberType},
        {name = "z", typ = NumberType}
      ] []);
    assert "allUnique: adjacent duplicate"
      (not (allUnique [
        {name = "x", typ = NumberType},
        {name = "x", typ = NumberType}
      ] []));
    assert "allUnique: nonadjacent duplicate with different types"
      (not (allUnique [
        {name = "x", typ = NumberType},
        {name = "y", typ = StringType},
        {name = "x", typ = BoolType}
      ] []));
    assert "allUnique: duplicate at the end"
      (not (allUnique [
        {name = "x", typ = NumberType},
        {name = "y", typ = BoolType},
        {name = "y", typ = StringType}
      ] []));
    assert "allUnique: first name already seen"
      (not (allUnique [{name = "x", typ = NumberType}] ["x"]));
    assert "allUnique: later name already seen"
      (not (allUnique [
        {name = "x", typ = NumberType},
        {name = "y", typ = BoolType}
      ] ["other", "y"]));
    assert "allUnique: disjoint seen names"
      (allUnique [{name = "x", typ = NumberType}] ["y", "z"]);
    assert "allUnique: names are case sensitive"
      (allUnique [
        {name = "x", typ = NumberType},
        {name = "X", typ = BoolType}
      ] []);
    assert "allUnique: empty names still count as names"
      (not (allUnique [
        {name = "", typ = NumberType},
        {name = "", typ = BoolType}
      ] []));
    assert "allUnique: works on expression fields"
      (allUnique [
        {name = "x", expr = NumberExpr 1.0},
        {name = "y", expr = BoolExpr true}
      ] []);
    assert "allUnique: rejects duplicate expression field names"
      (not (allUnique [
        {name = "x", expr = NumberExpr 1.0},
        {name = "x", expr = BoolExpr true}
      ] []));
    outputLnIO "✅ All passing for allUnique tests"
  };

let testAddBindings: IO Unit =
  let unchanged = addBindings scope2 [] in
  let extended = addBindings scope2 [
    {name = "x", typ = StringType},
    {name = "new", typ = NullType}
  ] in
  let duplicates = addBindings emptyScope [
    {name = "x", typ = NumberType},
    {name = "other", typ = NullType},
    {name = "x", typ = BoolType}
  ] in
  do (bindIO) {
    assert "addBindings: empty bindings into empty scope"
      ((addBindings emptyScope []) "missing" == None);
    assert "addBindings: empty bindings preserve existing names"
      (unchanged "x" == Some NumberType && unchanged "flag" == Some BoolType);
    assert "addBindings: empty bindings preserve missing names"
      (unchanged "missing" == None);
    assert "addBindings: singleton"
      ((addBindings emptyScope [{name = "x", typ = NumberType}]) "x"
        == Some NumberType);
    forEachTest (fn binding =>
      assert (str_concat "addBindings: binds " binding.name)
        (sampleScope binding.name == Some binding.typ)
    ) sampleBindings;
    assert "addBindings: new names" (extended "new" == Some NullType);
    assert "addBindings: shadows the base scope" (extended "x" == Some StringType);
    assert "addBindings: preserves unrelated base bindings"
      (extended "flag" == Some BoolType);
    assert "addBindings: missing name" (extended "missing" == None);
    # Duplicate validation belongs to allUnique; addBindings uses the last entry.
    assert "addBindings: later duplicate wins" (duplicates "x" == Some BoolType);
    assert "addBindings: duplicates preserve other entries"
      (duplicates "other" == Some NullType);
    assert "addBindings: original scope is unchanged" (scope2 "x" == Some NumberType);
    outputLnIO "✅ All passing for addBindings tests"
  };

let testTypeEquals: IO Unit =
  let recordA = RecordType [
    {name = "count", typ = NumberType},
    {name = "active", typ = BoolType}
  ] in
  let recordB = RecordType [
    {name = "active", typ = BoolType},
    {name = "count", typ = NumberType}
  ] in
  do (bindIO) {
    # All 36 pairs include primitive equality and every constructor mismatch.
    forEachTest (fn left =>
      forEachTest (fn right =>
        assert (str_concat "typeEquals: "
          (str_concat left.label (str_concat " vs " right.label)))
          (typeEquals left.typ right.typ == (left.label == right.label))
      ) exprSamples
    ) exprSamples;
    assert "typeEquals: zero-parameter functions"
      (typeEquals (FunctionType [] NullType) (FunctionType [] NullType));
    assert "typeEquals: function return type differs"
      (not (typeEquals (FunctionType [] NumberType) (FunctionType [] BoolType)));
    assert "typeEquals: first parameter differs"
      (not (typeEquals
        (FunctionType [NumberType, BoolType] NullType)
        (FunctionType [StringType, BoolType] NullType)));
    assert "typeEquals: later parameter differs"
      (not (typeEquals
        (FunctionType [NumberType, BoolType] NullType)
        (FunctionType [NumberType, StringType] NullType)));
    assert "typeEquals: parameter order matters"
      (not (typeEquals
        (FunctionType [NumberType, BoolType] NullType)
        (FunctionType [BoolType, NumberType] NullType)));
    assert "typeEquals: fewer parameters on the left"
      (not (typeEquals
        (FunctionType [NumberType] NullType)
        (FunctionType [NumberType, BoolType] NullType)));
    assert "typeEquals: fewer parameters on the right"
      (not (typeEquals
        (FunctionType [NumberType, BoolType] NullType)
        (FunctionType [NumberType] NullType)));
    assert "typeEquals: zero vs one parameter"
      (not (typeEquals (FunctionType [] NullType) (FunctionType [NullType] NullType)));
    assert "typeEquals: one vs zero parameters"
      (not (typeEquals (FunctionType [NullType] NullType) (FunctionType [] NullType)));
    assert "typeEquals: nested function parameter equality"
      (typeEquals
        (FunctionType [FunctionType [NumberType] BoolType] StringType)
        (FunctionType [FunctionType [NumberType] BoolType] StringType));
    assert "typeEquals: nested function parameter mismatch"
      (not (typeEquals
        (FunctionType [FunctionType [NumberType] BoolType] StringType)
        (FunctionType [FunctionType [StringType] BoolType] StringType)));
    assert "typeEquals: nested function return equality"
      (typeEquals
        (FunctionType [] (FunctionType [NumberType] BoolType))
        (FunctionType [] (FunctionType [NumberType] BoolType)));
    assert "typeEquals: nested function return mismatch"
      (not (typeEquals
        (FunctionType [] (FunctionType [NumberType] BoolType))
        (FunctionType [] (FunctionType [NumberType] StringType))));
    assert "typeEquals: empty records" (typeEquals (RecordType []) (RecordType []));
    assert "typeEquals: record order is irrelevant" (typeEquals recordA recordB);
    assert "typeEquals: reordered records compare symmetrically" (typeEquals recordB recordA);
    assert "typeEquals: different field name with the same type"
      (not (typeEquals
        (RecordType [{name = "x", typ = NumberType}])
        (RecordType [{name = "y", typ = NumberType}])));
    assert "typeEquals: field names are case sensitive"
      (not (typeEquals
        (RecordType [{name = "x", typ = NumberType}])
        (RecordType [{name = "X", typ = NumberType}])));
    assert "typeEquals: first field type differs"
      (not (typeEquals recordA (RecordType [
        {name = "count", typ = StringType}, {name = "active", typ = BoolType}
      ])));
    assert "typeEquals: later field type differs"
      (not (typeEquals recordA (RecordType [
        {name = "count", typ = NumberType}, {name = "active", typ = StringType}
      ])));
    assert "typeEquals: missing later field despite equal field counts"
      (not (typeEquals recordA (RecordType [
        {name = "count", typ = NumberType}, {name = "other", typ = BoolType}
      ])));
    assert "typeEquals: extra field on the left"
      (not (typeEquals recordA (RecordType [{name = "count", typ = NumberType}])));
    assert "typeEquals: extra field on the right"
      (not (typeEquals (RecordType [{name = "count", typ = NumberType}]) recordA));
    assert "typeEquals: empty vs nonempty record" (not (typeEquals (RecordType []) recordA));
    assert "typeEquals: nonempty vs empty record" (not (typeEquals recordA (RecordType [])));
    assert "typeEquals: reordered nested records"
      (typeEquals
        (RecordType [{name = "inner", typ = recordA}])
        (RecordType [{name = "inner", typ = recordB}]));
    assert "typeEquals: nested record mismatch"
      (not (typeEquals
        (RecordType [{name = "inner", typ = recordA}])
        (RecordType [{name = "inner", typ = RecordType []}])));
    assert "typeEquals: record parameters and returns use structural equality"
      (typeEquals (FunctionType [recordA] recordA) (FunctionType [recordB] recordB));
    assert "typeEquals: function-valued record fields"
      (typeEquals
        (RecordType [{name = "f", typ = FunctionType [recordA] recordA}])
        (RecordType [{name = "f", typ = FunctionType [recordB] recordB}]));
    assert "typeEquals: function-valued record field mismatch"
      (not (typeEquals
        (RecordType [{name = "f", typ = FunctionType [] NumberType}])
        (RecordType [{name = "f", typ = FunctionType [] BoolType}])));
    outputLnIO "✅ All passing for typeEquals tests"
  };

let testLookup: IO Unit =
  do (bindIO) {
    assert "lookup: empty environment" (lookup "x" [] == Err "unbound variable: x");
    assert "lookup: initial environment"
      (lookup "x" initialTypeEnv == Err "unbound variable: x");
    assert "lookup: several empty scopes"
      (lookup "missing" [emptyScope, emptyScope] == Err "unbound variable: missing");
    forEachTest (fn binding =>
      assert (str_concat "lookup: retrieves " binding.name)
        (lookup binding.name sampleEnv == Ok binding.typ)
    ) sampleBindings;
    assert "lookup: local binding" (lookup "x" [scope1] == Ok NumberType);
    assert "lookup: skips empty scopes"
      (lookup "x" [emptyScope, emptyScope, scope1] == Ok NumberType);
    assert "lookup: skips nonempty scopes without the name"
      (lookup "flag" [scope1, scope2] == Ok BoolType);
    assert "lookup: nearest binding wins" (lookup "x" [scope3, scope1] == Ok BoolType);
    assert "lookup: reversing scope order changes the nearest binding"
      (lookup "x" [scope1, scope3] == Ok NumberType);
    assert "lookup: missing name across nonempty scopes"
      (lookup "missing" [scope3, scope2, scope1] == Err "unbound variable: missing");
    assert "lookup: names are case sensitive"
      (lookup "X" [scope1] == Err "unbound variable: X");
    assert "lookup: includes the exact missing name"
      (lookup "" [] == Err "unbound variable: ");
    outputLnIO "✅ All passing for lookup tests"
  };

let testNumberExpr: IO Unit =
  do (bindIO) {
    assertExpr "NumberExpr: zero" (NumberExpr 0.0) [] (Ok NumberType);
    assertExpr "NumberExpr: positive" (NumberExpr 42.0) [] (Ok NumberType);
    assertExpr "NumberExpr: negative" (NumberExpr (-42.0)) [] (Ok NumberType);
    assertExpr "NumberExpr: fraction" (NumberExpr 0.125) [] (Ok NumberType);
    assertExpr "NumberExpr: negative fraction" (NumberExpr (-0.125)) [] (Ok NumberType);
    assertExpr "NumberExpr: large value" (NumberExpr 1000000000.0) [] (Ok NumberType);
    assertExpr "NumberExpr: ignores unrelated bindings" (NumberExpr 1.0) sampleEnv (Ok NumberType)
  };

let testBoolExpr: IO Unit =
  do (bindIO) {
    assertExpr "BoolExpr: true" (BoolExpr true) [] (Ok BoolType);
    assertExpr "BoolExpr: false" (BoolExpr false) [] (Ok BoolType);
    assertExpr "BoolExpr: ignores unrelated bindings" (BoolExpr false) sampleEnv (Ok BoolType)
  };

let testStringExpr: IO Unit =
  do (bindIO) {
    assertExpr "StringExpr: empty" (StringExpr "") [] (Ok StringType);
    assertExpr "StringExpr: ordinary text" (StringExpr "hello") [] (Ok StringType);
    assertExpr "StringExpr: whitespace and escapes" (StringExpr " \t\n\"quoted\"") [] (Ok StringType);
    assertExpr "StringExpr: Unicode" (StringExpr "hello 世界") [] (Ok StringType);
    assertExpr "StringExpr: ignores unrelated bindings" (StringExpr "x") sampleEnv (Ok StringType)
  };

let testNullExpr: IO Unit =
  do (bindIO) {
    assertExpr "NullExpr: empty environment" NullExpr [] (Ok NullType);
    assertExpr "NullExpr: populated environment" NullExpr sampleEnv (Ok NullType)
  };

let testVarExpr: IO Unit =
  do (bindIO) {
    forEachTest (fn binding =>
      assertExpr (str_concat "VarExpr: retrieves " binding.name)
        (VarExpr binding.name) sampleEnv (Ok binding.typ)
    ) sampleBindings;
    assertExpr "VarExpr: empty environment" (VarExpr "x") [] (Err "unbound variable: x");
    assertExpr "VarExpr: initial environment" (VarExpr "x") initialTypeEnv (Err "unbound variable: x");
    assertExpr "VarExpr: inner binding shadows outer binding"
      (VarExpr "x") [scope3, scope1] (Ok BoolType);
    assertExpr "VarExpr: looks through empty scopes"
      (VarExpr "x") [emptyScope, emptyScope, scope1] (Ok NumberType);
    assertExpr "VarExpr: looks through unrelated local bindings"
      (VarExpr "flag") [scope1, scope2] (Ok BoolType);
    assertExpr "VarExpr: missing in populated environment"
      (VarExpr "missing") sampleEnv (Err "unbound variable: missing");
    assertExpr "VarExpr: case-sensitive name"
      (VarExpr "Number") sampleEnv (Err "unbound variable: Number")
  };

let testAssignExpr: IO Unit =
  do (bindIO) {
    forEachTest (fn sample =>
      assertExpr (str_concat "AssignExpr: matching " sample.label)
        (AssignExpr sample.label sample.expr) sampleEnv (Ok sample.typ)
    ) exprSamples;
    # Reject every pair of different type constructors, in both directions.
    forEachTest (fn target =>
      forEachTest (fn value =>
        if target.label == value.label then
          pureIO unit
        else
          assertExpr (str_concat "AssignExpr: "
            (str_concat value.label (str_concat " into " target.label)))
            (AssignExpr target.label value.expr) sampleEnv (Err "assignment type mismatch")
      ) exprSamples
    ) exprSamples;
    assertExpr "AssignExpr: finds an outer binding"
      (AssignExpr "x" (NumberExpr 2.0)) [emptyScope, scope1] (Ok NumberType);
    assertExpr "AssignExpr: uses the innermost binding"
      (AssignExpr "x" (BoolExpr false)) [scope3, scope1] (Ok BoolType);
    assertExpr "AssignExpr: cannot bypass a shadowing binding"
      (AssignExpr "x" (NumberExpr 2.0)) [scope3, scope1] (Err "assignment type mismatch");
    assertExpr "AssignExpr: unbound target"
      (AssignExpr "missing" (NumberExpr 1.0)) sampleEnv (Err "unbound variable: missing");
    assertExpr "AssignExpr: RHS error propagates"
      (AssignExpr "number" (VarExpr "missingRhs")) sampleEnv (Err "unbound variable: missingRhs");
    assertExpr "AssignExpr: RHS error precedes missing target"
      (AssignExpr "missingTarget" (VarExpr "missingRhs")) [] (Err "unbound variable: missingRhs");
    assertExpr "AssignExpr: nested assignments return their assigned type"
      (AssignExpr "number" (AssignExpr "number" (NumberExpr 2.0))) sampleEnv (Ok NumberType);
    assertExpr "AssignExpr: nested assignment error propagates"
      (AssignExpr "number" (AssignExpr "boolean" (NumberExpr 2.0))) sampleEnv
      (Err "assignment type mismatch");
    assertExpr "AssignExpr: reordered record fields match and return the target type"
      (AssignExpr "record" (RecordExpr [
        {name = "active", expr = BoolExpr false},
        {name = "count", expr = NumberExpr 2.0}
      ])) sampleEnv
      (Ok (RecordType [{name = "count", typ = NumberType}, {name = "active", typ = BoolType}]));
    assertExpr "AssignExpr: record field type differs"
      (AssignExpr "record" (RecordExpr [
        {name = "count", expr = StringExpr "wrong"},
        {name = "active", expr = BoolExpr true}
      ])) sampleEnv (Err "assignment type mismatch");
    assertExpr "AssignExpr: record is missing a field"
      (AssignExpr "record" (RecordExpr [{name = "count", expr = NumberExpr 1.0}]))
      sampleEnv (Err "assignment type mismatch");
    assertExpr "AssignExpr: record has an extra field"
      (AssignExpr "record" (RecordExpr [
        {name = "count", expr = NumberExpr 1.0},
        {name = "active", expr = BoolExpr true},
        {name = "extra", expr = NullExpr}
      ])) sampleEnv (Err "assignment type mismatch");
    assertExpr "AssignExpr: function parameter type differs"
      (AssignExpr "function" (FnExpr
        [{name = "n", typ = BoolType}, {name = "text", typ = StringType}]
        BoolType (BoolExpr true))) sampleEnv (Err "assignment type mismatch");
    assertExpr "AssignExpr: function return type differs"
      (AssignExpr "function" (FnExpr
        [{name = "n", typ = NumberType}, {name = "text", typ = StringType}]
        NumberType (NumberExpr 1.0))) sampleEnv (Err "assignment type mismatch");
    assertExpr "AssignExpr: function arity differs"
      (AssignExpr "function" (FnExpr [] BoolType (BoolExpr true)))
      sampleEnv (Err "assignment type mismatch");
    assertExpr "AssignExpr: invalid RHS is rejected before comparing types"
      (AssignExpr "string" (UnaryOpExpr NegOp (BoolExpr true))) sampleEnv
      (Err "bad operand type for unary operator")
  };

let testUnaryOpExpr: IO Unit =
  do (bindIO) {
    assertExpr "UnaryOpExpr: negate a number"
      (UnaryOpExpr NegOp (NumberExpr 1.0)) [] (Ok NumberType);
    assertExpr "UnaryOpExpr: negate zero"
      (UnaryOpExpr NegOp (NumberExpr 0.0)) [] (Ok NumberType);
    assertExpr "UnaryOpExpr: negate a negative number"
      (UnaryOpExpr NegOp (NumberExpr (-1.0))) [] (Ok NumberType);
    assertExpr "UnaryOpExpr: not true"
      (UnaryOpExpr NotOp (BoolExpr true)) [] (Ok BoolType);
    assertExpr "UnaryOpExpr: not false"
      (UnaryOpExpr NotOp (BoolExpr false)) [] (Ok BoolType);
    forEachTest (fn sample =>
      do (bindIO) {
        if sample.label == "number" then pureIO unit else
          assertExpr (str_concat "UnaryOpExpr: negation rejects " sample.label)
            (UnaryOpExpr NegOp sample.expr) [] (Err "bad operand type for unary operator");
        if sample.label == "boolean" then pureIO unit else
          assertExpr (str_concat "UnaryOpExpr: not rejects " sample.label)
            (UnaryOpExpr NotOp sample.expr) [] (Err "bad operand type for unary operator")
      }
    ) exprSamples;
    assertExpr "UnaryOpExpr: nested negation"
      (UnaryOpExpr NegOp (UnaryOpExpr NegOp (NumberExpr 1.0))) [] (Ok NumberType);
    assertExpr "UnaryOpExpr: nested not"
      (UnaryOpExpr NotOp (UnaryOpExpr NotOp (BoolExpr false))) [] (Ok BoolType);
    assertExpr "UnaryOpExpr: operand comes from the environment"
      (UnaryOpExpr NegOp (VarExpr "number")) sampleEnv (Ok NumberType);
    assertExpr "UnaryOpExpr: negation propagates operand error"
      (UnaryOpExpr NegOp (VarExpr "missing")) [] (Err "unbound variable: missing");
    assertExpr "UnaryOpExpr: not propagates operand error"
      (UnaryOpExpr NotOp (VarExpr "missing")) [] (Err "unbound variable: missing");
    assertExpr "UnaryOpExpr: nested operand error propagates"
      (UnaryOpExpr NegOp (UnaryOpExpr NotOp (NumberExpr 1.0))) []
      (Err "bad operand type for unary operator")
  };

# Expectation tables below use this exact operator order.
let binaryOperators = [
  {label = "+", op = AddOp},
  {label = "-", op = SubOp},
  {label = "*", op = MulOp},
  {label = "/", op = DivOp},
  {label = "<", op = LtOp},
  {label = "<=", op = LeOp},
  {label = ">", op = GtOp},
  {label = ">=", op = GeOp},
  {label = "==", op = EqOp},
  {label = "!=", op = NeqOp},
  {label = "&&", op = AndOp},
  {label = "||", op = OrOp}
];

let assertBinaryResults label left right expectedResults =
  letrec checkOperators operators expected =
    match operators, expected {
      [], [] => pureIO unit;
      operator :: restOperators, result :: restResults =>
        do (bindIO) {
          assertExpr (str_concat label (str_concat " " operator.label))
            (BinOpExpr operator.op left right) [] result;
          checkOperators restOperators restResults
        };
      _, _ => assert "binary expectation table must cover every operator" false;
    }
  in checkOperators binaryOperators expectedResults;

let testNumericBinOpExpr: IO Unit =
  let unsupported = Err "unsupported binary operator for operand types" in
  do (bindIO) {
    assertBinaryResults "BinOpExpr: numbers" (NumberExpr 2.0) (NumberExpr 1.0) [
      Ok NumberType, Ok NumberType, Ok NumberType, Ok NumberType,
      Ok BoolType, Ok BoolType, Ok BoolType, Ok BoolType,
      Ok BoolType, Ok BoolType, unsupported, unsupported
    ];
    assertExpr "BinOpExpr: division by zero is still well typed"
      (BinOpExpr DivOp (NumberExpr 1.0) (NumberExpr 0.0)) [] (Ok NumberType);
    assertExpr "BinOpExpr: nested arithmetic"
      (BinOpExpr AddOp
        (BinOpExpr MulOp (NumberExpr (-2.0)) (NumberExpr 3.0))
        (BinOpExpr SubOp (NumberExpr 4.0) (NumberExpr 0.5))) [] (Ok NumberType);
    assertExpr "BinOpExpr: numeric variables"
      (BinOpExpr LtOp (VarExpr "number") (NumberExpr 0.0)) sampleEnv (Ok BoolType)
  };

let testStringBinOpExpr: IO Unit =
  let unsupported = Err "unsupported binary operator for operand types" in
  do (bindIO) {
    assertBinaryResults "BinOpExpr: strings" (StringExpr "a") (StringExpr "b") [
      Ok StringType, unsupported, unsupported, unsupported,
      unsupported, unsupported, unsupported, unsupported,
      Ok BoolType, Ok BoolType, unsupported, unsupported
    ];
    assertExpr "BinOpExpr: empty string concatenation"
      (BinOpExpr AddOp (StringExpr "") (StringExpr "")) [] (Ok StringType);
    assertExpr "BinOpExpr: nested string concatenation"
      (BinOpExpr AddOp (StringExpr "a")
        (BinOpExpr AddOp (StringExpr "b") (StringExpr "c"))) [] (Ok StringType)
  };

let testBoolBinOpExpr: IO Unit =
  let unsupported = Err "unsupported binary operator for operand types" in
  do (bindIO) {
    assertBinaryResults "BinOpExpr: booleans" (BoolExpr true) (BoolExpr false) [
      unsupported, unsupported, unsupported, unsupported,
      unsupported, unsupported, unsupported, unsupported,
      Ok BoolType, Ok BoolType, Ok BoolType, Ok BoolType
    ];
    assertExpr "BinOpExpr: nested comparisons and logic"
      (BinOpExpr AndOp
        (BinOpExpr LtOp (NumberExpr 1.0) (NumberExpr 2.0))
        (BinOpExpr OrOp (BoolExpr false) (BoolExpr true))) [] (Ok BoolType)
  };

let testNullBinOpExpr: IO Unit =
  let unsupported = Err "unsupported binary operator for operand types" in
  assertBinaryResults "BinOpExpr: nulls" NullExpr NullExpr [
    unsupported, unsupported, unsupported, unsupported,
    unsupported, unsupported, unsupported, unsupported,
    Ok BoolType, Ok BoolType, unsupported, unsupported
  ];

let testInvalidBinOpExpr: IO Unit =
  # All 12 operators on all 36 ordered type pairs. The four same-primitive
  # pairs are covered above; all other pairs, including record/record and
  # function/function, must produce an operand-type error.
  forEachTest (fn left =>
    forEachTest (fn right =>
      if left.label == right.label &&
        not (left.label == "function" || left.label == "record") then
        pureIO unit
      else
        forEachTest (fn operator =>
          assertExpr (str_concat "BinOpExpr: rejects "
            (str_concat left.label (str_concat " "
              (str_concat operator.label (str_concat " " right.label)))))
            (BinOpExpr operator.op left.expr right.expr) []
            (Err "bad operand types for binary operator")
        ) binaryOperators
    ) exprSamples
  ) exprSamples;

let testBinOpErrors: IO Unit =
  do (bindIO) {
    forEachTest (fn operator =>
      do (bindIO) {
        assertExpr (str_concat "BinOpExpr: left error for " operator.label)
          (BinOpExpr operator.op (VarExpr "leftMissing") (NumberExpr 1.0)) []
          (Err "unbound variable: leftMissing");
        assertExpr (str_concat "BinOpExpr: right error for " operator.label)
          (BinOpExpr operator.op (NumberExpr 1.0) (VarExpr "rightMissing")) []
          (Err "unbound variable: rightMissing");
        assertExpr (str_concat "BinOpExpr: left error wins for " operator.label)
          (BinOpExpr operator.op (VarExpr "leftMissing") (VarExpr "rightMissing")) []
          (Err "unbound variable: leftMissing")
      }
    ) binaryOperators;
    assertExpr "BinOpExpr: false && still checks the right operand"
      (BinOpExpr AndOp (BoolExpr false) (VarExpr "missing")) [] (Err "unbound variable: missing");
    assertExpr "BinOpExpr: true || still checks the right operand"
      (BinOpExpr OrOp (BoolExpr true) (VarExpr "missing")) [] (Err "unbound variable: missing");
    assertExpr "BinOpExpr: right error precedes operand compatibility"
      (BinOpExpr AddOp NullExpr (VarExpr "missing")) [] (Err "unbound variable: missing");
    assertExpr "BinOpExpr: nested error propagates"
      (BinOpExpr AddOp (NumberExpr 1.0)
        (UnaryOpExpr NegOp (BoolExpr true))) [] (Err "bad operand type for unary operator")
  };

let testBinOpExpr: IO Unit =
  do (bindIO) {
    testNumericBinOpExpr;
    testStringBinOpExpr;
    testBoolBinOpExpr;
    testNullBinOpExpr;
    testInvalidBinOpExpr;
    testBinOpErrors
  };

let testFnExpr: IO Unit =
  do (bindIO) {
    forEachTest (fn sample =>
      do (bindIO) {
        assertExpr (str_concat "FnExpr: zero parameters returning " sample.label)
          (FnExpr [] sample.typ sample.expr) [] (Ok (FunctionType [] sample.typ));
        assertExpr (str_concat "FnExpr: identity parameter of type " sample.label)
          (FnExpr [{name = "value", typ = sample.typ}] sample.typ (VarExpr "value")) []
          (Ok (FunctionType [sample.typ] sample.typ))
      }
    ) exprSamples;
    assertExpr "FnExpr: preserves parameter order"
      (FnExpr [{name = "n", typ = NumberType}, {name = "flag", typ = BoolType}]
        BoolType (VarExpr "flag")) [] (Ok (FunctionType [NumberType, BoolType] BoolType));
    assertExpr "FnExpr: captures an outer variable"
      (FnExpr [] NumberType (VarExpr "number")) sampleEnv (Ok (FunctionType [] NumberType));
    assertExpr "FnExpr: parameters shadow outer variables"
      (FnExpr [{name = "number", typ = StringType}] StringType (VarExpr "number")) sampleEnv
      (Ok (FunctionType [StringType] StringType));
    assertExpr "FnExpr: unrelated outer bindings remain visible"
      (FnExpr [{name = "value", typ = StringType}] NumberType (VarExpr "number")) sampleEnv
      (Ok (FunctionType [StringType] NumberType));
    assertExpr "FnExpr: nested function captures an enclosing parameter"
      (FnExpr [{name = "x", typ = NumberType}] (FunctionType [] NumberType)
        (FnExpr [] NumberType (VarExpr "x"))) []
      (Ok (FunctionType [NumberType] (FunctionType [] NumberType)));
    assertExpr "FnExpr: nested parameter shadows enclosing parameter"
      (FnExpr [{name = "x", typ = NumberType}] (FunctionType [BoolType] BoolType)
        (FnExpr [{name = "x", typ = BoolType}] BoolType (VarExpr "x"))) []
      (Ok (FunctionType [NumberType] (FunctionType [BoolType] BoolType)));
    assertExpr "FnExpr: case-sensitive parameter names are distinct"
      (FnExpr [{name = "x", typ = NumberType}, {name = "X", typ = BoolType}]
        BoolType (VarExpr "X")) [] (Ok (FunctionType [NumberType, BoolType] BoolType));
    assertExpr "FnExpr: duplicate parameter with the same type"
      (FnExpr [{name = "x", typ = NumberType}, {name = "x", typ = NumberType}]
        NumberType (VarExpr "x")) [] (Err "duplicate parameter names");
    assertExpr "FnExpr: nonadjacent duplicate with different types"
      (FnExpr [
        {name = "x", typ = NumberType},
        {name = "y", typ = StringType},
        {name = "x", typ = BoolType}
      ] BoolType (VarExpr "x")) [] (Err "duplicate parameter names");
    assertExpr "FnExpr: duplicate parameters are rejected before the body"
      (FnExpr [{name = "x", typ = NumberType}, {name = "x", typ = BoolType}]
        NumberType (VarExpr "missing")) [] (Err "duplicate parameter names");
    assertExpr "FnExpr: primitive return mismatch"
      (FnExpr [] BoolType (NumberExpr 1.0)) [] (Err "expected boolean, got number");
    assertExpr "FnExpr: nested function return mismatch"
      (FnExpr [] (FunctionType [NumberType] NumberType)
        (FnExpr [] NumberType (NumberExpr 1.0))) []
      (Err "expected (number) -> number, got () -> number");
    assertExpr "FnExpr: record return mismatch"
      (FnExpr [] (RecordType [{name = "count", typ = BoolType}])
        (RecordExpr [{name = "count", expr = NumberExpr 1.0}])) []
      (Err "expected {count: boolean}, got {count: number}");
    assertExpr "FnExpr: reordered return fields match and preserve the annotation"
      (FnExpr []
        (RecordType [{name = "count", typ = NumberType}, {name = "active", typ = BoolType}])
        (RecordExpr [
          {name = "active", expr = BoolExpr true},
          {name = "count", expr = NumberExpr 1.0}
        ])) []
      (Ok (FunctionType []
        (RecordType [{name = "count", typ = NumberType}, {name = "active", typ = BoolType}])));
    assertExpr "FnExpr: body lookup error propagates"
      (FnExpr [] NumberType (VarExpr "missing")) [] (Err "unbound variable: missing");
    assertExpr "FnExpr: body operator error propagates"
      (FnExpr [] NumberType (UnaryOpExpr NegOp (BoolExpr true))) []
      (Err "bad operand type for unary operator");
    assertExpr "FnExpr: nested parameter does not leak into the enclosing body"
      (FnExpr [{name = "x", typ = NumberType}] NumberType
        (BinOpExpr AddOp
          (AppExpr (FnExpr [{name = "y", typ = NumberType}] NumberType (VarExpr "y"))
            [NumberExpr 1.0])
          (VarExpr "y"))) []
      (Err "unbound variable: y");
    assertExpr "FnExpr: parameters do not leak into sibling record fields"
      (RecordExpr [
        {name = "f", expr = FnExpr [{name = "value", typ = NumberType}] NumberType (VarExpr "value")},
        {name = "outside", expr = VarExpr "value"}
      ]) [] (Err "unbound variable: value")
  };

let testAppExpr: IO Unit =
  let identity = FnExpr [{name = "value", typ = NumberType}] NumberType (VarExpr "value") in
  let recordParam = FnExpr [
    {name = "r", typ = RecordType [
      {name = "count", typ = NumberType}, {name = "active", typ = BoolType}
    ]}
  ] NumberType (FieldExpr (VarExpr "r") "count") in
  let higherOrder = FnExpr [
    {name = "f", typ = FunctionType [NumberType] NumberType}
  ] NumberType (AppExpr (VarExpr "f") [NumberExpr 1.0]) in
  do (bindIO) {
    assertExpr "AppExpr: direct identity application"
      (AppExpr identity [NumberExpr 2.0]) [] (Ok NumberType);
    forEachTest (fn sample =>
      do (bindIO) {
        assertExpr (str_concat "AppExpr: nullary function returning " sample.label)
          (AppExpr (FnExpr [] sample.typ sample.expr) []) [] (Ok sample.typ);
        assertExpr (str_concat "AppExpr: matching argument of type " sample.label)
          (AppExpr
            (FnExpr [{name = "value", typ = sample.typ}] sample.typ (VarExpr "value"))
            [sample.expr]) [] (Ok sample.typ)
      }
    ) exprSamples;
    assertExpr "AppExpr: function from the environment"
      (AppExpr (VarExpr "function") [NumberExpr 1.0, StringExpr "text"]) sampleEnv (Ok BoolType);
    assertExpr "AppExpr: arguments use the caller environment"
      (AppExpr (VarExpr "function") [VarExpr "number", VarExpr "string"]) sampleEnv (Ok BoolType);
    assertExpr "AppExpr: arguments use the nearest caller binding"
      (AppExpr (FnExpr [{name = "value", typ = BoolType}] BoolType (VarExpr "value"))
        [VarExpr "x"]) [scope3, scope1] (Ok BoolType);
    assertExpr "AppExpr: callee parameters do not bind argument variables"
      (AppExpr identity [VarExpr "value"]) [] (Err "unbound variable: value");
    assertExpr "AppExpr: callee shadowing does not change argument lookup"
      (AppExpr (FnExpr [{name = "number", typ = StringType}] StringType (VarExpr "number"))
        [VarExpr "number"]) sampleEnv (Err "expected string, got number");
    assertExpr "AppExpr: nested application of a returned function"
      (AppExpr
        (AppExpr (FnExpr [] (FunctionType [NumberType] NumberType) identity) [])
        [NumberExpr 1.0]) [] (Ok NumberType);
    assertExpr "AppExpr: function-valued record field"
      (AppExpr (FieldExpr (RecordExpr [{name = "f", expr = identity}]) "f")
        [NumberExpr 1.0]) [] (Ok NumberType);
    assertExpr "AppExpr: higher-order argument"
      (AppExpr higherOrder [identity]) [] (Ok NumberType);
    assertExpr "AppExpr: higher-order parameter mismatch"
      (AppExpr higherOrder [
        FnExpr [{name = "value", typ = BoolType}] NumberType (NumberExpr 1.0)
      ]) [] (Err "expected (number) -> number, got (boolean) -> number");
    assertExpr "AppExpr: record argument may reorder fields"
      (AppExpr recordParam [RecordExpr [
        {name = "active", expr = BoolExpr true}, {name = "count", expr = NumberExpr 1.0}
      ]]) [] (Ok NumberType);
    assertExpr "AppExpr: record argument is missing a field"
      (AppExpr recordParam [RecordExpr [{name = "count", expr = NumberExpr 1.0}]]) []
      (Err "expected {count: number, active: boolean}, got {count: number}");
    assertExpr "AppExpr: record argument has an extra field"
      (AppExpr recordParam [RecordExpr [
        {name = "count", expr = NumberExpr 1.0},
        {name = "active", expr = BoolExpr true},
        {name = "extra", expr = NullExpr}
      ]]) []
      (Err "expected {count: number, active: boolean}, got {count: number, active: boolean, extra: null}");
    forEachTest (fn sample =>
      if sample.label == "function" then pureIO unit else
        assertExpr (str_concat "AppExpr: rejects non-function " sample.label)
          (AppExpr sample.expr []) [] (Err "application requires a function")
    ) exprSamples;
    assertExpr "AppExpr: non-function error precedes argument errors"
      (AppExpr (NumberExpr 1.0) [VarExpr "missing"]) [] (Err "application requires a function");
    assertExpr "AppExpr: missing function error propagates"
      (AppExpr (VarExpr "missingFunction") []) [] (Err "unbound variable: missingFunction");
    assertExpr "AppExpr: function error precedes argument errors"
      (AppExpr (VarExpr "missingFunction") [VarExpr "missingArgument"]) []
      (Err "unbound variable: missingFunction");
    assertExpr "AppExpr: invalid function body error propagates"
      (AppExpr (FnExpr [] BoolType (NumberExpr 1.0)) []) []
      (Err "expected boolean, got number");
    assertExpr "AppExpr: no arguments for a non-nullary function"
      (AppExpr identity []) [] (Err "number of arguments does not match number of parameters");
    assertExpr "AppExpr: too few arguments"
      (AppExpr (VarExpr "function") [NumberExpr 1.0]) sampleEnv
      (Err "number of arguments does not match number of parameters");
    assertExpr "AppExpr: too many arguments"
      (AppExpr (VarExpr "function") [NumberExpr 1.0, StringExpr "x", NullExpr]) sampleEnv
      (Err "number of arguments does not match number of parameters");
    assertExpr "AppExpr: argument supplied to a nullary function"
      (AppExpr (FnExpr [] NullType NullExpr) [NumberExpr 1.0]) []
      (Err "number of arguments does not match number of parameters");
    assertExpr "AppExpr: arity error precedes invalid argument expressions"
      (AppExpr (VarExpr "function") [VarExpr "missing"]) sampleEnv
      (Err "number of arguments does not match number of parameters");
    assertExpr "AppExpr: first argument type mismatch"
      (AppExpr (VarExpr "function") [BoolExpr true, StringExpr "x"]) sampleEnv
      (Err "expected number, got boolean");
    assertExpr "AppExpr: later argument type mismatch"
      (AppExpr (VarExpr "function") [NumberExpr 1.0, BoolExpr true]) sampleEnv
      (Err "expected string, got boolean");
    assertExpr "AppExpr: argument order matters"
      (AppExpr (VarExpr "function") [StringExpr "x", NumberExpr 1.0]) sampleEnv
      (Err "expected number, got string");
    assertExpr "AppExpr: first argument lookup error propagates"
      (AppExpr (VarExpr "function") [VarExpr "firstMissing", StringExpr "x"]) sampleEnv
      (Err "unbound variable: firstMissing");
    assertExpr "AppExpr: later argument lookup error propagates"
      (AppExpr (VarExpr "function") [NumberExpr 1.0, VarExpr "laterMissing"]) sampleEnv
      (Err "unbound variable: laterMissing");
    assertExpr "AppExpr: first argument error wins"
      (AppExpr (VarExpr "function") [VarExpr "firstMissing", VarExpr "laterMissing"]) sampleEnv
      (Err "unbound variable: firstMissing");
    assertExpr "AppExpr: first type mismatch precedes a later lookup error"
      (AppExpr (VarExpr "function") [BoolExpr true, VarExpr "laterMissing"]) sampleEnv
      (Err "expected number, got boolean")
  };

let testRecordExpr: IO Unit =
  do (bindIO) {
    assertExpr "RecordExpr: empty record" (RecordExpr []) [] (Ok (RecordType []));
    forEachTest (fn sample =>
      assertExpr (str_concat "RecordExpr: field of type " sample.label)
        (RecordExpr [{name = "value", expr = sample.expr}]) []
        (Ok (RecordType [{name = "value", typ = sample.typ}]))
    ) exprSamples;
    assertExpr "RecordExpr: mixed fields retain names, types, and order"
      (RecordExpr (map (fn sample => {name = sample.label, expr = sample.expr}) exprSamples)) []
      (Ok (RecordType sampleBindings));
    assertExpr "RecordExpr: values can use outer bindings"
      (RecordExpr [{name = "value", expr = VarExpr "number"}]) sampleEnv
      (Ok (RecordType [{name = "value", typ = NumberType}]));
    assertExpr "RecordExpr: nested record"
      (RecordExpr [{name = "inner", expr = RecordExpr [
        {name = "count", expr = NumberExpr 1.0}, {name = "empty", expr = RecordExpr []}
      ]}]) []
      (Ok (RecordType [{name = "inner", typ = RecordType [
        {name = "count", typ = NumberType}, {name = "empty", typ = RecordType []}
      ]}]));
    assertExpr "RecordExpr: duplicate adjacent field names"
      (RecordExpr [
        {name = "x", expr = NumberExpr 1.0}, {name = "x", expr = NumberExpr 2.0}
      ]) [] (Err "duplicate record field names");
    assertExpr "RecordExpr: nonadjacent duplicate with different value types"
      (RecordExpr [
        {name = "x", expr = NumberExpr 1.0},
        {name = "y", expr = NullExpr},
        {name = "x", expr = BoolExpr true}
      ]) [] (Err "duplicate record field names");
    assertExpr "RecordExpr: duplicate names are rejected before field expressions"
      (RecordExpr [
        {name = "x", expr = VarExpr "missing"}, {name = "x", expr = BoolExpr true}
      ]) [] (Err "duplicate record field names");
    assertExpr "RecordExpr: case-sensitive field names are distinct"
      (RecordExpr [
        {name = "x", expr = NumberExpr 1.0}, {name = "X", expr = BoolExpr true}
      ]) [] (Ok (RecordType [{name = "x", typ = NumberType}, {name = "X", typ = BoolType}]));
    assertExpr "RecordExpr: first field error propagates"
      (RecordExpr [
        {name = "bad", expr = VarExpr "missing"}, {name = "ok", expr = NullExpr}
      ]) [] (Err "unbound variable: missing");
    assertExpr "RecordExpr: later field error propagates"
      (RecordExpr [
        {name = "ok", expr = NullExpr}, {name = "bad", expr = VarExpr "missing"}
      ]) [] (Err "unbound variable: missing");
    assertExpr "RecordExpr: first error wins when multiple fields fail"
      (RecordExpr [
        {name = "first", expr = VarExpr "firstMissing"},
        {name = "last", expr = VarExpr "lastMissing"}
      ]) [] (Err "unbound variable: firstMissing");
    assertExpr "RecordExpr: nested duplicate error propagates"
      (RecordExpr [{name = "inner", expr = RecordExpr [
        {name = "x", expr = NullExpr}, {name = "x", expr = NullExpr}
      ]}]) [] (Err "duplicate record field names");
    assertExpr "RecordExpr: field names do not bind sibling expressions"
      (RecordExpr [
        {name = "x", expr = NumberExpr 1.0}, {name = "copy", expr = VarExpr "x"}
      ]) [] (Err "unbound variable: x");
    assertExpr "RecordExpr: sibling names do not shadow outer bindings"
      (RecordExpr [
        {name = "number", expr = StringExpr "local field"},
        {name = "copy", expr = VarExpr "number"}
      ]) sampleEnv
      (Ok (RecordType [{name = "number", typ = StringType}, {name = "copy", typ = NumberType}]))
  };

let testFieldExpr: IO Unit =
  let fields = RecordExpr [
    {name = "first", expr = NumberExpr 1.0},
    {name = "middle", expr = BoolExpr true},
    {name = "last", expr = StringExpr "text"}
  ] in
  do (bindIO) {
    forEachTest (fn sample =>
      assertExpr (str_concat "FieldExpr: field of type " sample.label)
        (FieldExpr (RecordExpr [{name = "value", expr = sample.expr}]) "value") []
        (Ok sample.typ)
    ) exprSamples;
    assertExpr "FieldExpr: first field" (FieldExpr fields "first") [] (Ok NumberType);
    assertExpr "FieldExpr: middle field" (FieldExpr fields "middle") [] (Ok BoolType);
    assertExpr "FieldExpr: last field" (FieldExpr fields "last") [] (Ok StringType);
    assertExpr "FieldExpr: record variable from the environment"
      (FieldExpr (VarExpr "record") "count") sampleEnv (Ok NumberType);
    assertExpr "FieldExpr: nested field access"
      (FieldExpr
        (FieldExpr (RecordExpr [{name = "inner", expr = fields}]) "inner")
        "last") [] (Ok StringType);
    assertExpr "FieldExpr: record returned by a function"
      (FieldExpr
        (AppExpr (FnExpr [] (RecordType [{name = "value", typ = NumberType}])
          (RecordExpr [{name = "value", expr = NumberExpr 1.0}])) [])
        "value") [] (Ok NumberType);
    assertExpr "FieldExpr: missing field in empty record"
      (FieldExpr (RecordExpr []) "missing") [] (Err "record has no field named missing");
    assertExpr "FieldExpr: missing field in nonempty record"
      (FieldExpr fields "missing") [] (Err "record has no field named missing");
    assertExpr "FieldExpr: field names are case sensitive"
      (FieldExpr fields "First") [] (Err "record has no field named First");
    forEachTest (fn sample =>
      if sample.label == "record" then pureIO unit else
        assertExpr (str_concat "FieldExpr: rejects non-record " sample.label)
          (FieldExpr sample.expr "value") [] (Err "accessing field on a non-record")
    ) exprSamples;
    assertExpr "FieldExpr: source lookup error propagates"
      (FieldExpr (VarExpr "missingRecord") "value") [] (Err "unbound variable: missingRecord");
    assertExpr "FieldExpr: invalid record field error propagates"
      (FieldExpr (RecordExpr [{name = "bad", expr = VarExpr "missing"}]) "bad") []
      (Err "unbound variable: missing");
    assertExpr "FieldExpr: all fields are checked before selecting a valid field"
      (FieldExpr (RecordExpr [
        {name = "ok", expr = NumberExpr 1.0}, {name = "bad", expr = VarExpr "missing"}
      ]) "ok") [] (Err "unbound variable: missing");
    assertExpr "FieldExpr: duplicate record fields are rejected before selection"
      (FieldExpr (RecordExpr [
        {name = "x", expr = NumberExpr 1.0}, {name = "x", expr = BoolExpr true}
      ]) "x") [] (Err "duplicate record field names");
    assertExpr "FieldExpr: nested missing-field error propagates"
      (FieldExpr (FieldExpr fields "missingInner") "value") []
      (Err "record has no field named missingInner")
  };

let testCheckExpr: IO Unit =
  do (bindIO) {
    testNumberExpr;
    testBoolExpr;
    testStringExpr;
    testNullExpr;
    testVarExpr;
    testAssignExpr;
    testUnaryOpExpr;
    testBinOpExpr;
    testFnExpr;
    testAppExpr;
    testRecordExpr;
    testFieldExpr;
    outputLnIO "✅ All passing for checkExpr tests"
  };

let main: IO Unit =
  do (bindIO) {
    testScope;
    testInArr;
    testAllUnique;
    testAddBindings;
    testTypeEquals;
    testLookup;
    testCheckExpr;
    outputLnIO "✅ All passing"
  };
