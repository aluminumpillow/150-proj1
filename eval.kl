// removed inclusion of syntax and common since it will be included during testing

type alias Location = Int;

type alias EnvScope = String -> (Option Location);
type alias Env = List EnvScope;

type Value
  = NumberVal Float
  | BoolVal Bool
  | StringVal String
  | NullVal
  | RecordVal [{name: String, val: Value}]
  | ClosureVal [String] Expr Env;

type alias Store = {
  nextLoc: Location,
  mem: Location -> (Option Value)
};

type alias Execution = {
  env: Env,
  store: Store
};

type alias RuntimeError = String;

# emptyEnvScope : EnvScope
let emptyEnvScope =
  fn _ => None;

# initialEnv : Env
let initialEnv = [emptyEnvScope];

# pushEnvScope : Env -> Env
let pushEnvScope env =
  emptyEnvScope :: env;

# extendEnvScope : EnvScope -> String -> Location -> EnvScope
let extendEnvScope scope name loc =
  fn query =>
    if query == name then
      Some loc
    else
      scope query;

# bindEnvLocal : String -> Location -> Env -> Env
let bindEnvLocal name loc env =
  match env {
    scope :: rest => (extendEnvScope scope name loc) :: rest;
    [] => [extendEnvScope emptyEnvScope name loc];
  };

# lookupEnv : String -> Env -> Result Location RuntimeError
letrec lookupEnv name env =
  match env {
    [] =>
      Err (str_concat "unbound variable: " name);

    scope :: rest =>
      match scope name {
        Some loc => Ok loc;
        None => lookupEnv name rest;
      };
  };

// store operations
let emptyStore = {
  nextLoc = 0,
  mem = fn _ => None
};

# alloc :: Value -> Store -> {loc: Location, store: Store}
let alloc val store =
  let loc = store.nextLoc in
  let nextMem = fn query =>
    if query == loc then
      Some val
    else
      store.mem query
  in
    {
      loc = loc,
      store = {
        nextLoc = loc + 1,
        mem = nextMem
      }
    };

let lookupStore loc store =
  match store.mem loc {
    Some val => Ok val;
    None => Err "unallocated store location";
  };

let updateStore loc val store =
  {
    nextLoc = store.nextLoc,
    mem = fn query =>
      if query == loc then
        Some val
      else
        store.mem query
  };

  # | NumberExpr Float
  # | BoolExpr Bool
  # | StringExpr String
  # | NullExpr
  # | VarExpr String
  # | AssignExpr String Expr

# applyUnOp : UnaryOp -> Value -> Result Value RuntimeError
let applyUnOp op v =
  match op {
    NegOp =>
      match v {
        NumberVal n => Ok (NumberVal (0.0 -. n));
        _ => Err "invalid operand for -";
      };
    NotOp =>
      match v {
        BoolVal b => Ok (BoolVal (not b));
        _ => Err "invalid operand for !";
      };
  };

# numOp : (Float -> Float -> Value) -> Value -> Value -> Result Value RuntimeError
let numOp f v1 v2 =
  match v1 {
    NumberVal a =>
      match v2 {
        NumberVal b => Ok (f a b);
        _ => Err "invalid operands: expected numbers";
      };
    _ => Err "invalid operands: expected numbers";
  };

# primEq : Value -> Value -> Result Bool RuntimeError
let primEq v1 v2 =
  match v1 {
    NumberVal a => match v2 { NumberVal b => Ok (a == b); _ => Err "invalid equality"; };
    BoolVal a   => match v2 { BoolVal b   => Ok (a == b); _ => Err "invalid equality"; };
    StringVal a => match v2 { StringVal b => Ok (a == b); _ => Err "invalid equality"; };
    NullVal     => match v2 { NullVal     => Ok true;     _ => Err "invalid equality"; };
    _ => Err "invalid equality";
  };

# applyBinOp : BinOp -> Value -> Value -> Result Value RuntimeError
let applyBinOp op v1 v2 =
  match op {
    AddOp =>
      match v1 {
        StringVal a =>
          match v2 {
            StringVal b => Ok (StringVal (str_concat a b));
            _ => Err "invalid operands for +";
          };
        _ => numOp (fn a b => NumberVal (a +. b)) v1 v2;
      };
    SubOp => numOp (fn a b => NumberVal (a -. b)) v1 v2;
    MulOp => numOp (fn a b => NumberVal (a *. b)) v1 v2;
    DivOp =>
      match v1 {
        NumberVal a =>
          match v2 {
            NumberVal b =>
              if b == 0.0 then
                Err "division by zero"
              else
                numOp (fn a b => NumberVal (a /. b)) v1 v2;
            _ => Err "invalid operands for /";
          };
        _ => Err "invalid operands for /";
      };
    LtOp => numOp (fn a b => BoolVal (a <. b))  v1 v2;
    LeOp => numOp (fn a b => BoolVal (a <=. b)) v1 v2;
    GtOp => numOp (fn a b => BoolVal (a >. b))  v1 v2;
    GeOp => numOp (fn a b => BoolVal (a >=. b)) v1 v2;
    EqOp =>
      match (primEq v1 v2) {
        Ok b => Ok (BoolVal b);
        Err err => Err err;
      };
    NeqOp =>
      match (primEq v1 v2) {
        Ok b => Ok (BoolVal (not b));
        Err err => Err err;
      };
    _ => Err "not a strict operator";
  };

# helper functions for 4e.
# bindParams : [String] -> [Value] -> Env -> Store -> Result { env: Env, store: Store } RuntimeError
letrec bindParams params args env store =
  match params {
    [] =>
      match args {
        [] => Ok { env = env, store = store };
        _ => Err "too many arguments in function call";
      };

    x :: restParams =>
      match args {
        [] => Err "too few arguments in function call";
        v :: restArgs =>
          let allocated = alloc v store in
          let nextEnv = bindEnvLocal x allocated.loc env in
            bindParams restParams restArgs nextEnv allocated.store;
      };
  };

# lookupField : String -> [{ name: String, val: Value }] -> Result Value RuntimeError
letrec lookupField fieldName fields =
  match fields {
    [] =>
      Err (str_concat "unknown record field: " fieldName);

    f :: rest =>
      if f.name == fieldName then
        Ok f.val
      else
        lookupField fieldName rest;
  };

# evalExpr : Expr -> Env -> Store -> Result { val: Value, store: Store } RuntimeError
letrec evalExpr expr env store =
  // for lists in E-List 
  letrec evalExprList exprs st =
    match exprs {
      [] =>
        Ok { vals = [], store = st };

      e :: rest =>
        match (evalExpr e env st) {
          Err err => Err err;
          Ok r1 =>
            match (evalExprList rest r1.store) {
              Err err => Err err;
              Ok r2 =>
                Ok { vals = r1.val :: r2.vals, store = r2.store };
            };
        };
    }
  in
  // for lists in E-List 
  letrec evalRecordFields fields st =
    match fields {
      [] =>
        Ok { fields = [], store = st };

      fld :: rest =>
        match (evalExpr fld.expr env st) {
          Err err => Err err;
          Ok r1 =>
            match (evalRecordFields rest r1.store) {
              Err err => Err err;
              Ok r2 =>
                Ok {
                  fields = { name = fld.name, val = r1.val } :: r2.fields,
                  store = r2.store
                };
            };
        };
    }
  in

  match expr {
    // E-Number
    NumberExpr n => 
      Ok {val = NumberVal n, store = store};

    // E-String
    StringExpr q =>
      Ok {val = StringVal q, store = store};

    // E-Bool
    BoolExpr b =>
      Ok {val = BoolVal b, store = store};

    // E-Null
    NullExpr =>
      Ok {val = NullVal, store = store};

    // E-Var
    VarExpr x =>
      // first condition: p(x) = l
      match (lookupEnv x env) {
        Err err => 
          Err err;
        Ok loc =>
          // second condition: sigma(l) = v
          match (lookupStore loc store) {
            Err err =>
              Err err;
            Ok v =>
              Ok {val = v, store = store}; // final value -> rightmost denominator
          };
      };

    // E-Assign
    AssignExpr x e =>
      // first condition: p(x) = l
      match (lookupEnv x env) {
        Err err => 
          Err err;
        Ok loc =>
          // second condition: recursively evaluate e under same env and store
          match (evalExpr e env store) {
            Err err =>
              Err err;
            Ok res =>
              Ok {val = res.val, store = (updateStore loc res.val res.store)};
          };
        };

    // E-Unary
    UnaryOpExpr op e =>
      match (evalExpr e env store) {
        Err err => Err err;
        Ok r =>
          match (applyUnOp op r.val) {
            Err err => Err err;
            Ok v2 => Ok {val = v2, store = r.store};
          };
      };

    // E-Binary
    BinOpExpr op e1 e2 =>
      match op {
        AndOp => 
          // E-AndFalse, E-AndTrue
          // first condition: recursively evaluate e1 under same env and store
          match (evalExpr e1 env store) {
            Err err => Err err;
            Ok r1 =>
              match r1.val {
                BoolVal false =>
                  Ok {val = BoolVal false, store = r1.store};
          // second condition: recursively evaluate e2 under same env but r1.store
                BoolVal true =>
                   match (evalExpr e2 env r1.store) {
                     Err err => Err err;
                     Ok r2 =>
                       match r2.val {
                         BoolVal b =>
                           Ok {val = BoolVal b, store = r2.store};
                           _ => Err "right operand of && must be a boolean";
                       };
                  };
                  _ => Err "left operand of && must be a boolean";
              };
          };
        OrOp => 
          // basically opposite of AndOp
          // E-OrTrue, e-OrFalse
          // first condition: 
          match (evalExpr e1 env store) {
            Err err => Err err;
            Ok r1 =>
              match r1.val {
                BoolVal true => // true then Ok, else second condition
                  Ok {val = BoolVal true, store = r1.store};
                BoolVal false =>
                   match (evalExpr e2 env r1.store) {
                     Err err => Err err;
                     Ok r2 =>
                       match r2.val {
                         BoolVal b =>
                           Ok {val = BoolVal b, store = r2.store};
                         _ => Err "right operand of || must be a boolean";
                       };
                  };
                  _ => Err "left operand of || must be a boolean";
              };
          };
        _ =>
          match (evalExpr e1 env store) {
            Err err => Err err;
            Ok r1 =>
              match (evalExpr e2 env r1.store) {
                Err err => Err err;
                Ok r2 =>
                  match (applyBinOp op r1.val r2.val) {
                    Err err => Err err;
                    Ok v => Ok {val = v, store = r2.store};
                  };
              };
          };
      };
    // E-Fun
    FnExpr params retType body =>
      let paramNames = map (fn p => p.name) params in
        Ok {
          val = ClosureVal paramNames body env,
          store = store
        };

    // E-App
    AppExpr callee args =>
      match (evalExpr callee env store) {
        Err err => Err err;
        Ok r0 =>
          match r0.val {
            ClosureVal paramNames body closureEnv =>
              // arity check before arugment evaluation
              if length args < length paramNames then
                Err "too few arguments in function call"
              else if length args > length paramNames then
                Err "too many arguments in function call"
              else
                match (evalExprList args r0.store) {
                  Err err => Err err;
                  Ok returnArgs =>
                    match (bindParams paramNames returnArgs.vals (pushEnvScope closureEnv) returnArgs.store) {
                      Err err => Err err;
                      Ok bound =>
                        evalExpr body bound.env bound.store;
                    };
                };

            _ =>
              Err "attempted to call a non-function";
          };
      };

    // E-Record
    RecordExpr fields =>
      match (evalRecordFields fields store) {
        Err err => Err err;
        Ok res =>
          Ok {
            val = RecordVal res.fields,
            store = res.store
          };
      };

    // E-Field
    FieldExpr target fieldName =>
      match (evalExpr target env store) {
        Err err => Err err;
        Ok res =>
          match res.val {
            RecordVal fields =>
              match (lookupField fieldName fields) {
                Err err => Err err;
                Ok v => Ok { val = v, store = res.store };
              };

            _ =>
              Err "field access on a non-record";
          };
      };
  };


# evalStmt : Stmt -> Env -> Store -> Result {env: Env, store: Store} RuntimeError
letrec execStmt stmt env store = 

  // S-SeqEmpty and S-SeqCons (same functionality as checkStmts)
  #  [Stmt] -> Env -> Store -> Result (Env, Store) RuntimeError
  letrec execStmts stmts env store =
    match stmts {
      [] => Ok ({env = env, store = store});

      stmt :: rest =>
        match execStmt stmt env store {
          Err err => Err err;

          Ok envStore =>
            execStmts rest envStore.env envStore.store;  
        };
    }
  in
    match stmt {
      LetStmt name _ expr =>
        match env {
          [] => Err "runtime environment has no current scope";
          innerScope :: outerScopes =>
            match innerScope name {
              Some _ =>
                Err (str_concat "duplicate declaration: " name);
              None =>
                match evalExpr expr env store {
                  Err err => Err err;
                  Ok valStore =>
                    let allocated = alloc valStore.val valStore.store in
                    let nextEnv = bindEnvLocal name allocated.loc env in
                      Ok ({env = nextEnv, store = allocated.store});
                };
            };
        };

      ExprStmt expr =>
        match evalExpr expr env store {
          Err err => Err err;
          Ok valStore =>
            Ok ({env = env, store = valStore.store}); 
        };

      BlockStmt block =>
        match execStmts block (pushEnvScope env) store {
          Err err => Err err;
          Ok envStore => Ok ({env = env, store = envStore.store});
        };

      IfStmt expr ifBlock optionElseBlock =>
        match evalExpr expr env store {
          Err err => Err err;
          Ok valStore => 
            match valStore.val {
              BoolVal bool =>
                // true case
                if bool then
                  match execStmt (BlockStmt ifBlock) env valStore.store {
                    Err err => Err err;
                    Ok envStore => Ok ({env = env, store = envStore.store});
                  }
                else
                  // false case, check first if else branch exists
                  match optionElseBlock {
                    Some elseBlock =>
                      match execStmt (BlockStmt elseBlock) env valStore.store {
                        Err err => Err err;
                        Ok envStore => Ok ({env = env, store = envStore.store});
                      };
                    None => Ok ({env = env, store = valStore.store}); // if no else branch exists, just return the evaluated store
                  };
                  
              _ => Err "if conditional expression is not boolean"; 
            };
        };

      WhileStmt expr block =>
        match evalExpr expr env store {
          Err err => Err err;
          Ok valStore =>
            match valStore.val {
              BoolVal bool =>
                // true case
                if bool then
                  match execStmt (BlockStmt block) env valStore.store {
                    Err err => Err err;
                    Ok envStore =>
                     execStmt stmt env envStore.store;
                  }
                // false case
                else
                  Ok ({env = env, store = valStore.store});
                
              _ => Err "while conditional expression is not boolean"; 
            }; 
        };
      
      _ => Err "invalid statement expression";
    };

# execProgram :: Program -> Result Execution RuntimeError
letrec execProgram program =
  letrec execStmts stmts env store =
    match stmts {
      [] => Ok ({env = env, store = store});

      stmt :: rest =>
        match execStmt stmt env store {
          Err err => Err err;

          Ok envStore =>
            execStmts rest envStore.env envStore.store;  
        };
    }
  in
    match execStmts program initialEnv emptyStore {
      Err err => Err err;
      Ok envStore => Ok envStore;
    };
  
    
let main = pureIO unit;
