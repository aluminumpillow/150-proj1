# Included by test_checker.kl after checker.kl.
# Use these helpers for success/errors, or match Ok env to inspect bindings.
# Environments contain scope functions, so do not compare whole results with ==.
let stmtSucceeds result =
  match result {
    Ok _ => true;
    Err _ => false;
  };

let stmtFailsWith result expected =
  match result {
    Ok _ => false;
    Err actual => actual == expected;
  };

let testLetStmt: IO Unit =
  let numberScope = extendScope emptyScope "x" NumberType in
  do (bindIO) {
    assert "let introduces x without adding a scope"
      (match checkStmt (LetStmt "x" None (NumberExpr 1.0)) initialTypeEnv {
        Ok env => length env == 1 && (localScope env) "x" == Some NumberType;
        Err _ => false;
      });
    assert "let accepts a matching annotation"
      (stmtSucceeds (checkStmt
        (LetStmt "message" (Some StringType) (StringExpr "hello")) initialTypeEnv));
    assert "let may shadow an outer declaration"
      (match checkStmt (LetStmt "x" None (BoolExpr true)) [emptyScope, numberScope] {
        Ok env => length env == 2 && (localScope env) "x" == Some BoolType;
        Err _ => false;
      });
    assert "shadowing initializer reads the outer x"
      (match checkStmt (LetStmt "x" None (VarExpr "x")) [emptyScope, numberScope] {
        Ok env => (localScope env) "x" == Some NumberType;
        Err _ => false;
      });
    assert "reject a duplicate declaration in the current scope"
      (stmtFailsWith (checkStmt (LetStmt "x" None (BoolExpr true)) [numberScope])
        "duplicate declaration: x");
    assert "a declaration cannot use itself in its initializer"
      (stmtFailsWith (checkStmt (LetStmt "self" (Some NumberType) (VarExpr "self")) initialTypeEnv)
        "unbound variable: self");
    assert "reject an annotation mismatch"
      (stmtFailsWith (checkStmt (LetStmt "x" (Some BoolType) (NumberExpr 1.0)) initialTypeEnv)
        "expected boolean, got number");
    assert "a declaration requires a current scope"
      (stmtFailsWith (checkStmt (LetStmt "x" None (NumberExpr 1.0)) [])
        "type environment has no current scope")
  };

let testLetAnnotations: IO Unit =
  let documentedType = FunctionType [{name = "documented", typ = NumberType}] NumberType in
  let identity = FnExpr [{name = "actual", typ = NumberType}] NumberType (VarExpr "actual") in
  let actualType = FunctionType [{name = "actual", typ = NumberType}] NumberType in
  let recordType = RecordType [
    {name = "count", typ = NumberType}, {name = "active", typ = BoolType}
  ] in
  let reorderedRecord = RecordExpr [
    {name = "active", expr = BoolExpr true}, {name = "count", expr = NumberExpr 1.0}
  ] in
  do (bindIO) {
    assert "function annotations may rename parameters"
      (match checkStmt (LetStmt "f" (Some documentedType) identity) initialTypeEnv {
        Ok env => lookup "f" env == Ok actualType;
        Err _ => false;
      });
    assert "record annotations may reorder fields"
      (match checkStmt (LetStmt "r" (Some recordType) reorderedRecord) initialTypeEnv {
        Ok env => lookup "r" env == Ok (RecordType [
          {name = "active", typ = BoolType}, {name = "count", typ = NumberType}
        ]);
        Err _ => false;
      });
    assert "reject a function annotation with the wrong arity"
      (stmtFailsWith (checkStmt (LetStmt "f" (Some documentedType)
        (FnExpr [] NumberType (NumberExpr 1.0))) initialTypeEnv)
        "expected (number) -> number, got () -> number")
  };

let testLetTypeValidation: IO Unit =
  let duplicateRecordType = RecordType [
    {name = "x", typ = NumberType}, {name = "x", typ = BoolType}
  ] in
  let duplicateFunctionType = FunctionType [
    {name = "x", typ = NumberType}, {name = "x", typ = BoolType}
  ] NumberType in
  let nestedCallbackType = RecordType [
    {name = "makeCallback", typ = FunctionType [] duplicateFunctionType}
  ] in
  let numberScope = extendScope emptyScope "x" NumberType in
  do (bindIO) {
    assert "reject duplicate record fields in an annotation"
      (stmtFailsWith (checkStmt (LetStmt "r" (Some duplicateRecordType) NullExpr) initialTypeEnv)
        "duplicate record field names");
    assert "reject duplicate function-type parameters in an annotation"
      (stmtFailsWith (checkStmt (LetStmt "f" (Some duplicateFunctionType) NullExpr) initialTypeEnv)
        "duplicate function type parameter name");
    assert "validate function types nested inside record fields and return types"
      (stmtFailsWith (checkStmt (LetStmt "r" (Some nestedCallbackType) NullExpr) initialTypeEnv)
        "duplicate function type parameter name");
    assert "validate record types nested inside function parameters"
      (stmtFailsWith (checkStmt (LetStmt "f" (Some (FunctionType [
        {name = "record", typ = duplicateRecordType}
      ] NullType)) NullExpr) initialTypeEnv) "duplicate record field names");
    assert "initializer errors precede duplicate declarations and invalid annotations"
      (stmtFailsWith (checkStmt (LetStmt "x" (Some duplicateRecordType) (VarExpr "missing"))
        [numberScope]) "unbound variable: missing");
    assert "duplicate declarations precede annotation validation"
      (stmtFailsWith (checkStmt (LetStmt "x" (Some duplicateFunctionType) NullExpr) [numberScope])
        "duplicate declaration: x")
  };

let testExprStmt: IO Unit =
  let envWithX = [extendScope emptyScope "x" NumberType] in
  let identity = FnExpr [{name = "parameter", typ = NumberType}] NumberType (VarExpr "parameter") in
  do (bindIO) {
    assert "an assignment statement preserves the variable type and scope depth"
      (match checkStmt (ExprStmt (AssignExpr "x" (NumberExpr 2.0))) envWithX {
        Ok env => length env == 1 && lookup "x" env == Ok NumberType;
        Err _ => false;
      });
    assert "an expression statement does not introduce function parameters"
      (match checkStmt (ExprStmt identity) initialTypeEnv {
        Ok env => length env == 1 && lookup "parameter" env == Err "unbound variable: parameter";
        Err _ => false;
      });
    assert "expression statement errors propagate"
      (stmtFailsWith (checkStmt (ExprStmt (UnaryOpExpr NotOp (NumberExpr 1.0))) initialTypeEnv)
        "bad operand type for unary operator")
  };

let testBlockStmt: IO Unit =
  let envWithX = [extendScope emptyScope "x" NumberType] in
  let usesEarlierDeclaration = BlockStmt [
    LetStmt "local" None (NumberExpr 1.0),
    LetStmt "copy" None (BinOpExpr AddOp (VarExpr "local") (VarExpr "x")),
    ExprStmt (VarExpr "copy")
  ] in
  let shadowsOuterX = BlockStmt [
    LetStmt "x" None (BoolExpr true), ExprStmt (UnaryOpExpr NotOp (VarExpr "x"))
  ] in
  do (bindIO) {
    assert "empty block succeeds"
      (stmtSucceeds (checkStmt (BlockStmt []) initialTypeEnv));
    assert "block declarations reach later statements and stay local"
      (match checkStmt usesEarlierDeclaration envWithX {
        Ok env => length env == 1 && lookup "x" env == Ok NumberType &&
          lookup "local" env == Err "unbound variable: local" &&
          lookup "copy" env == Err "unbound variable: copy";
        Err _ => false;
      });
    assert "block shadowing restores the outer binding"
      (match checkStmt shadowsOuterX envWithX {
        Ok env => length env == 1 && lookup "x" env == Ok NumberType;
        Err _ => false;
      });
    assert "reject duplicate declarations in one block"
      (stmtFailsWith (checkStmt (BlockStmt [
        LetStmt "x" None NullExpr, LetStmt "x" None NullExpr
      ]) initialTypeEnv) "duplicate declaration: x");
    assert "nested block locals cannot escape into the enclosing block"
      (stmtFailsWith (checkStmt (BlockStmt [
        BlockStmt [LetStmt "inside" None NullExpr], ExprStmt (VarExpr "inside")
      ]) initialTypeEnv) "unbound variable: inside");
    assert "reject a use before its declaration"
      (stmtFailsWith (checkStmt (BlockStmt [
        ExprStmt (VarExpr "later"), LetStmt "later" None (NumberExpr 1.0)
      ]) initialTypeEnv) "unbound variable: later");
    assert "report the first statement error"
      (stmtFailsWith (checkStmt (BlockStmt [
        ExprStmt (VarExpr "firstMissing"), ExprStmt (VarExpr "lastMissing")
      ]) initialTypeEnv) "unbound variable: firstMissing")
  };

let testIfStmt: IO Unit =
  let envWithX = [extendScope emptyScope "x" NumberType] in
  let independentBranches = IfStmt (BoolExpr false)
    [LetStmt "local" None (NumberExpr 1.0)]
    (Some [LetStmt "local" None (BoolExpr true)]) in
  let shadowsOuterX = IfStmt (BoolExpr true)
    [LetStmt "x" None (BoolExpr true), ExprStmt (UnaryOpExpr NotOp (VarExpr "x"))]
    (Some [ExprStmt (BinOpExpr AddOp (VarExpr "x") (NumberExpr 1.0))]) in
  do (bindIO) {
    assert "if without else succeeds"
      (stmtSucceeds (checkStmt (IfStmt (BoolExpr true) [] None) initialTypeEnv));
    assert "branches have independent local scopes"
      (match checkStmt independentBranches envWithX {
        Ok env => length env == 1 && lookup "x" env == Ok NumberType &&
          lookup "local" env == Err "unbound variable: local";
        Err _ => false;
      });
    assert "branch shadowing preserves the outer x and the other branch"
      (match checkStmt shadowsOuterX envWithX {
        Ok env => length env == 1 && lookup "x" env == Ok NumberType;
        Err _ => false;
      });
    assert "reject a non-boolean condition before checking branches"
      (stmtFailsWith (checkStmt (IfStmt (NumberExpr 1.0)
        [ExprStmt (VarExpr "badBody")] None) initialTypeEnv) "expected boolean, got number");
    assert "condition expression errors propagate"
      (stmtFailsWith (checkStmt (IfStmt (VarExpr "missing") [] None) initialTypeEnv)
        "unbound variable: missing");
    assert "check the then branch first even when the condition is false"
      (stmtFailsWith (checkStmt (IfStmt (BoolExpr false)
        [ExprStmt (VarExpr "badThen")] (Some [ExprStmt (VarExpr "badElse")])) initialTypeEnv)
        "unbound variable: badThen");
    assert "check the else branch even when the condition is true"
      (stmtFailsWith (checkStmt (IfStmt (BoolExpr true) []
        (Some [ExprStmt (VarExpr "badElse")])) initialTypeEnv) "unbound variable: badElse");
    assert "else cannot see then-local declarations"
      (stmtFailsWith (checkStmt (IfStmt (BoolExpr true) [LetStmt "thenLocal" None NullExpr]
        (Some [ExprStmt (VarExpr "thenLocal")])) initialTypeEnv) "unbound variable: thenLocal")
  };

let testWhileStmt: IO Unit =
  let envWithX = [extendScope emptyScope "x" NumberType] in
  let usesLocalAndOuterBindings = WhileStmt (BoolExpr false) [
    LetStmt "local" None (NumberExpr 1.0),
    ExprStmt (AssignExpr "x" (BinOpExpr AddOp (VarExpr "local") (VarExpr "x")))
  ] in
  let shadowsOuterX = WhileStmt (BoolExpr true) [
    LetStmt "x" None (BoolExpr true), ExprStmt (UnaryOpExpr NotOp (VarExpr "x"))
  ] in
  do (bindIO) {
    assert "type-check a true loop without executing it"
      (stmtSucceeds (checkStmt (WhileStmt (BoolExpr true) []) initialTypeEnv));
    assert "loop declarations reach later body statements and stay local"
      (match checkStmt usesLocalAndOuterBindings envWithX {
        Ok env => length env == 1 && lookup "x" env == Ok NumberType &&
          lookup "local" env == Err "unbound variable: local";
        Err _ => false;
      });
    assert "loop shadowing preserves the outer binding"
      (match checkStmt shadowsOuterX envWithX {
        Ok env => length env == 1 && lookup "x" env == Ok NumberType;
        Err _ => false;
      });
    assert "reject a non-boolean condition before checking the body"
      (stmtFailsWith (checkStmt (WhileStmt NullExpr [ExprStmt (VarExpr "badBody")]) initialTypeEnv)
        "expected boolean, got null");
    assert "body declarations cannot bind variables in the condition"
      (stmtFailsWith (checkStmt (WhileStmt (VarExpr "localFlag")
        [LetStmt "localFlag" None (BoolExpr true)]) initialTypeEnv) "unbound variable: localFlag");
    assert "check a false loop body and report its first error"
      (stmtFailsWith (checkStmt (WhileStmt (BoolExpr false) [
        ExprStmt (VarExpr "firstMissing"), ExprStmt (VarExpr "lastMissing")
      ]) initialTypeEnv) "unbound variable: firstMissing")
  };

let testCheckStmt: IO Unit =
  do (bindIO) {
    testLetStmt;
    testLetAnnotations;
    testLetTypeValidation;
    testExprStmt;
    testBlockStmt;
    testIfStmt;
    testWhileStmt;
    outputLnIO "✅ All passing for checkStmt tests"
  };
