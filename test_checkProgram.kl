# Included by test_checker.kl after checker.kl.
# Copy an assert, write a short AST program, and compare its complete result.

let testProgramBasics: IO Unit =
  do (bindIO) {
    assert "empty program"
      (checkProgram [] == Ok unit);
    assert "declarations reach later initializers and assignments"
      (checkProgram [
        LetStmt "x" None (NumberExpr 1.0),
        LetStmt "y" (Some NumberType) (BinOpExpr AddOp (VarExpr "x") (NumberExpr 2.0)),
        ExprStmt (AssignExpr "x" (VarExpr "y"))
      ] == Ok unit)
  };

let testProgramDeclarations: IO Unit =
  do (bindIO) {
    assert "reject a use before its declaration"
      (checkProgram [ExprStmt (VarExpr "later"), LetStmt "later" None (NumberExpr 1.0)]
        == Err "unbound variable: later");
    assert "annotations do not allow self-reference in an initializer"
      (checkProgram [LetStmt "self" (Some NumberType) (VarExpr "self")]
        == Err "unbound variable: self");
    assert "let-bound functions are not implicitly recursive"
      (checkProgram [LetStmt "f" None (FnExpr [] NumberType (AppExpr (VarExpr "f") []))]
        == Err "unbound variable: f");
    assert "reject duplicate top-level declarations even with different types"
      (checkProgram [LetStmt "x" None (NumberExpr 1.0), LetStmt "x" None (BoolExpr true)]
        == Err "duplicate declaration: x");
    assert "declaration names are case sensitive"
      (checkProgram [
        LetStmt "x" None (NumberExpr 1.0),
        LetStmt "X" None (BoolExpr true),
        ExprStmt (AssignExpr "x" (NumberExpr 2.0)),
        ExprStmt (UnaryOpExpr NotOp (VarExpr "X"))
      ] == Ok unit);
    assert "one invocation may declare a global"
      (checkProgram [LetStmt "global" None (NumberExpr 1.0)] == Ok unit);
    assert "the next invocation starts with an empty scope"
      (checkProgram [ExprStmt (VarExpr "global")] == Err "unbound variable: global");
    assert "a fresh invocation may reuse the same name"
      (checkProgram [LetStmt "global" None (BoolExpr true)] == Ok unit)
  };

let testProgramScopes: IO Unit =
  do (bindIO) {
    assert "block shadowing restores the outer type for later statements"
      (checkProgram [
        LetStmt "x" None (NumberExpr 1.0),
        BlockStmt [
          LetStmt "x" None (BoolExpr true), ExprStmt (UnaryOpExpr NotOp (VarExpr "x"))
        ],
        ExprStmt (BinOpExpr AddOp (VarExpr "x") (NumberExpr 2.0))
      ] == Ok unit);
    assert "sibling blocks and the top level may reuse a local name"
      (checkProgram [
        BlockStmt [LetStmt "local" None (NumberExpr 1.0)],
        BlockStmt [LetStmt "local" None (BoolExpr true)],
        LetStmt "local" None (StringExpr "outside")
      ] == Ok unit);
    assert "block declarations do not escape"
      (checkProgram [
        BlockStmt [LetStmt "local" None (NumberExpr 1.0)], ExprStmt (VarExpr "local")
      ] == Err "unbound variable: local");
    assert "then and else declarations do not escape"
      (checkProgram [
        IfStmt (BoolExpr true) [LetStmt "local" None (NumberExpr 1.0)]
          (Some [LetStmt "local" None (BoolExpr true)]),
        ExprStmt (VarExpr "local")
      ] == Err "unbound variable: local");
    assert "loop declarations do not escape"
      (checkProgram [
        WhileStmt (BoolExpr false) [LetStmt "local" None (NumberExpr 1.0)],
        ExprStmt (VarExpr "local")
      ] == Err "unbound variable: local")
  };

let testProgramErrors: IO Unit =
  do (bindIO) {
    assert "report the first statement error"
      (checkProgram [ExprStmt (VarExpr "firstMissing"), ExprStmt (VarExpr "lastMissing")]
        == Err "unbound variable: firstMissing");
    assert "errors after a successful declaration propagate"
      (checkProgram [LetStmt "x" None (NumberExpr 1.0), ExprStmt (VarExpr "missing")]
        == Err "unbound variable: missing");
    assert "annotation mismatches propagate"
      (checkProgram [LetStmt "x" (Some BoolType) (NumberExpr 1.0)]
        == Err "expected boolean, got number");
    assert "assignment mismatches propagate"
      (checkProgram [LetStmt "x" None (NumberExpr 1.0), ExprStmt (AssignExpr "x" (BoolExpr true))]
        == Err "assignment type mismatch");
    assert "check a then branch even when its condition is false"
      (checkProgram [IfStmt (BoolExpr false) [ExprStmt (VarExpr "badThen")] None]
        == Err "unbound variable: badThen");
    assert "check an else branch even when its condition is true"
      (checkProgram [IfStmt (BoolExpr true) [] (Some [ExprStmt (VarExpr "badElse")])]
        == Err "unbound variable: badElse");
    assert "check a loop body even when its condition is false"
      (checkProgram [WhileStmt (BoolExpr false) [ExprStmt (VarExpr "badBody")]]
        == Err "unbound variable: badBody")
  };

let testProgramAnnotations: IO Unit =
  let duplicateRecordType = RecordType [
    {name = "x", typ = NumberType}, {name = "x", typ = BoolType}
  ] in
  let duplicateFunctionType = FunctionType [
    {name = "x", typ = NumberType}, {name = "x", typ = BoolType}
  ] NumberType in
  let nestedCallbackType = RecordType [{name = "callback", typ = duplicateFunctionType}] in
  do (bindIO) {
    assert "reject duplicate record fields in an annotation"
      (checkProgram [LetStmt "r" (Some duplicateRecordType) (RecordExpr [])]
        == Err "duplicate record field names");
    assert "duplicate function-type parameters precede errors in later statements"
      (checkProgram [
        LetStmt "before" None (NumberExpr 1.0),
        LetStmt "f" (Some duplicateFunctionType) NullExpr,
        ExprStmt (VarExpr "laterMissing")
      ] == Err "duplicate function type parameter name");
    assert "validate function types nested inside record annotations"
      (checkProgram [LetStmt "r" (Some nestedCallbackType) NullExpr]
        == Err "duplicate function type parameter name");
    assert "validate unused function parameter annotations"
      (checkProgram [LetStmt "f" None
        (FnExpr [{name = "callback", typ = duplicateFunctionType}] NullType NullExpr)]
        == Err "duplicate function type parameter name");
    assert "initializer errors precede invalid annotations"
      (checkProgram [LetStmt "x" (Some duplicateRecordType) (VarExpr "missing")]
        == Err "unbound variable: missing");
    assert "duplicate declarations precede annotation validation"
      (checkProgram [
        LetStmt "x" None (NumberExpr 1.0),
        LetStmt "x" (Some duplicateFunctionType) NullExpr
      ] == Err "duplicate declaration: x")
  };

let testProgramFunctionsAndRecords: IO Unit =
  let documentedType = FunctionType [{name = "documented", typ = NumberType}] NumberType in
  let addOffset = FnExpr [{name = "actual", typ = NumberType}] NumberType
    (BinOpExpr AddOp (VarExpr "actual") (VarExpr "offset")) in
  let recordType = RecordType [
    {name = "count", typ = NumberType}, {name = "active", typ = BoolType}
  ] in
  let reorderedRecord = RecordExpr [
    {name = "active", expr = BoolExpr true}, {name = "count", expr = NumberExpr 1.0}
  ] in
  let identity = FnExpr [{name = "actual", typ = NumberType}] NumberType (VarExpr "actual") in
  let boxType = RecordType [{name = "convert", typ = documentedType}] in
  let box = RecordExpr [{name = "convert", expr = identity}] in
  do (bindIO) {
    assert "an annotated function captures an earlier declaration and may rename parameters"
      (checkProgram [
        LetStmt "offset" None (NumberExpr 2.0),
        LetStmt "addOffset" (Some documentedType) addOffset,
        LetStmt "answer" (Some NumberType) (AppExpr (VarExpr "addOffset") [NumberExpr 40.0])
      ] == Ok unit);
    assert "a reordered record annotation supports later field access"
      (checkProgram [
        LetStmt "r" (Some recordType) reorderedRecord,
        LetStmt "count" (Some NumberType) (FieldExpr (VarExpr "r") "count"),
        IfStmt (FieldExpr (VarExpr "r") "active") [] None
      ] == Ok unit);
    assert "call an annotated function stored in a record"
      (checkProgram [
        LetStmt "box" (Some boxType) box,
        LetStmt "result" (Some NumberType)
          (AppExpr (FieldExpr (VarExpr "box") "convert") [NumberExpr 1.0])
      ] == Ok unit)
  };

let testCheckProgram: IO Unit =
  do (bindIO) {
    testProgramBasics;
    testProgramDeclarations;
    testProgramScopes;
    testProgramErrors;
    testProgramAnnotations;
    testProgramFunctionsAndRecords;
    outputLnIO "✅ All passing for checkProgram tests"
  };
