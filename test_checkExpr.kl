# Included by test_checker.kl after checker.kl.

let testLiteralExpr: IO Unit =
  do (bindIO) {
    assert "number literal"
      (checkExpr (NumberExpr 1.0) initialTypeEnv == Ok NumberType);
    assert "boolean literal"
      (checkExpr (BoolExpr true) initialTypeEnv == Ok BoolType);
    assert "string literal"
      (checkExpr (StringExpr "hello") initialTypeEnv == Ok StringType);
    assert "null literal"
      (checkExpr NullExpr initialTypeEnv == Ok NullType)
  };

let testVarExpr: IO Unit =
  let numberScope = extendScope emptyScope "x" NumberType in
  let booleanScope = extendScope emptyScope "x" BoolType in
  do (bindIO) {
    assert "look up x"
      (checkExpr (VarExpr "x") [numberScope] == Ok NumberType);
    assert "inner x shadows outer x"
      (checkExpr (VarExpr "x") [booleanScope, numberScope] == Ok BoolType);
    assert "look through an empty scope"
      (checkExpr (VarExpr "x") [emptyScope, numberScope] == Ok NumberType);
    assert "reject an unbound variable"
      (checkExpr (VarExpr "missing") initialTypeEnv == Err "unbound variable: missing");
    assert "variable names are case sensitive"
      (checkExpr (VarExpr "X") [numberScope] == Err "unbound variable: X")
  };

let testAssignExpr: IO Unit =
  let numberScope = extendScope emptyScope "x" NumberType in
  let booleanScope = extendScope emptyScope "x" BoolType in
  do (bindIO) {
    assert "assign the same type"
      (checkExpr (AssignExpr "x" (NumberExpr 2.0)) [numberScope] == Ok NumberType);
    assert "reject a different assignment type"
      (checkExpr (AssignExpr "x" (BoolExpr true)) [numberScope]
        == Err "assignment type mismatch");
    assert "assign an outer variable"
      (checkExpr (AssignExpr "x" (NumberExpr 2.0)) [emptyScope, numberScope] == Ok NumberType);
    assert "assign the innermost x"
      (checkExpr (AssignExpr "x" (BoolExpr false)) [booleanScope, numberScope] == Ok BoolType);
    assert "assignment cannot skip a shadowing binding"
      (checkExpr (AssignExpr "x" (NumberExpr 2.0)) [booleanScope, numberScope]
        == Err "assignment type mismatch");
    assert "reject assignment to an unbound variable"
      (checkExpr (AssignExpr "missing" (NumberExpr 1.0)) initialTypeEnv
        == Err "unbound variable: missing");
    assert "check the RHS before looking up the assignment target"
      (checkExpr (AssignExpr "missingTarget" (VarExpr "missingRhs")) initialTypeEnv
        == Err "unbound variable: missingRhs");
    assert "nested assignments return their type"
      (checkExpr (AssignExpr "x" (AssignExpr "x" (NumberExpr 2.0))) [numberScope]
        == Ok NumberType)
  };

let testCompositeAssignments: IO Unit =
  let recordType = RecordType [
    {name = "count", typ = NumberType}, {name = "active", typ = BoolType}
  ] in
  let recordEnv = [extendScope emptyScope "record" recordType] in
  let reorderedRecord = RecordExpr [
    {name = "active", expr = BoolExpr true}, {name = "count", expr = NumberExpr 2.0}
  ] in
  let functionType = FunctionType [{name = "x", typ = NumberType}] NumberType in
  let functionEnv = [extendScope emptyScope "f" functionType] in
  let renamedIdentity = FnExpr [{name = "renamed", typ = NumberType}]
    NumberType (VarExpr "renamed") in
  let wrongReturn = FnExpr [{name = "x", typ = NumberType}] BoolType (BoolExpr true) in
  do (bindIO) {
    assert "record assignment ignores field order and returns the target type"
      (checkExpr (AssignExpr "record" reorderedRecord) recordEnv == Ok recordType);
    assert "function assignment ignores parameter names and returns the target type"
      (checkExpr (AssignExpr "f" renamedIdentity) functionEnv == Ok functionType);
    assert "reject an assignment with a different function return type"
      (checkExpr (AssignExpr "f" wrongReturn) functionEnv == Err "assignment type mismatch")
  };

let testUnaryOpExpr: IO Unit =
  do (bindIO) {
    assert "negate a number"
      (checkExpr (UnaryOpExpr NegOp (NumberExpr 1.0)) initialTypeEnv == Ok NumberType);
    assert "negate a boolean with not"
      (checkExpr (UnaryOpExpr NotOp (BoolExpr false)) initialTypeEnv == Ok BoolType);
    assert "reject numeric negation of a boolean"
      (checkExpr (UnaryOpExpr NegOp (BoolExpr true)) initialTypeEnv
        == Err "bad operand type for unary operator");
    assert "reject not on a number"
      (checkExpr (UnaryOpExpr NotOp (NumberExpr 1.0)) initialTypeEnv
        == Err "bad operand type for unary operator");
    assert "unary operators propagate operand errors"
      (checkExpr (UnaryOpExpr NegOp (VarExpr "missing")) initialTypeEnv
        == Err "unbound variable: missing")
  };

let testNumberOperators: IO Unit =
  do (bindIO) {
    assert "add numbers"
      (checkExpr (BinOpExpr AddOp (NumberExpr 2.0) (NumberExpr 1.0)) initialTypeEnv == Ok NumberType);
    assert "subtract numbers"
      (checkExpr (BinOpExpr SubOp (NumberExpr 2.0) (NumberExpr 1.0)) initialTypeEnv == Ok NumberType);
    assert "multiply numbers"
      (checkExpr (BinOpExpr MulOp (NumberExpr 2.0) (NumberExpr 1.0)) initialTypeEnv == Ok NumberType);
    assert "divide numbers"
      (checkExpr (BinOpExpr DivOp (NumberExpr 2.0) (NumberExpr 1.0)) initialTypeEnv == Ok NumberType);
    assert "division by zero is still well typed"
      (checkExpr (BinOpExpr DivOp (NumberExpr 1.0) (NumberExpr 0.0)) initialTypeEnv == Ok NumberType);
    assert "compare numbers with <"
      (checkExpr (BinOpExpr LtOp (NumberExpr 1.0) (NumberExpr 2.0)) initialTypeEnv == Ok BoolType);
    assert "compare numbers with <="
      (checkExpr (BinOpExpr LeOp (NumberExpr 1.0) (NumberExpr 2.0)) initialTypeEnv == Ok BoolType);
    assert "compare numbers with >"
      (checkExpr (BinOpExpr GtOp (NumberExpr 1.0) (NumberExpr 2.0)) initialTypeEnv == Ok BoolType);
    assert "compare numbers with >="
      (checkExpr (BinOpExpr GeOp (NumberExpr 1.0) (NumberExpr 2.0)) initialTypeEnv == Ok BoolType);
    assert "number equality"
      (checkExpr (BinOpExpr EqOp (NumberExpr 1.0) (NumberExpr 2.0)) initialTypeEnv == Ok BoolType);
    assert "number inequality"
      (checkExpr (BinOpExpr NeqOp (NumberExpr 1.0) (NumberExpr 2.0)) initialTypeEnv == Ok BoolType);
    assert "reject && on numbers"
      (checkExpr (BinOpExpr AndOp (NumberExpr 1.0) (NumberExpr 2.0)) initialTypeEnv
        == Err "unsupported binary operator for operand types")
  };

let testOtherOperators: IO Unit =
  do (bindIO) {
    assert "concatenate strings"
      (checkExpr (BinOpExpr AddOp (StringExpr "a") (StringExpr "b")) initialTypeEnv == Ok StringType);
    assert "string equality"
      (checkExpr (BinOpExpr EqOp (StringExpr "a") (StringExpr "b")) initialTypeEnv == Ok BoolType);
    assert "string inequality"
      (checkExpr (BinOpExpr NeqOp (StringExpr "a") (StringExpr "b")) initialTypeEnv == Ok BoolType);
    assert "boolean and"
      (checkExpr (BinOpExpr AndOp (BoolExpr true) (BoolExpr false)) initialTypeEnv == Ok BoolType);
    assert "boolean or"
      (checkExpr (BinOpExpr OrOp (BoolExpr true) (BoolExpr false)) initialTypeEnv == Ok BoolType);
    assert "boolean equality"
      (checkExpr (BinOpExpr EqOp (BoolExpr true) (BoolExpr false)) initialTypeEnv == Ok BoolType);
    assert "boolean inequality"
      (checkExpr (BinOpExpr NeqOp (BoolExpr true) (BoolExpr false)) initialTypeEnv == Ok BoolType);
    assert "null equality"
      (checkExpr (BinOpExpr EqOp NullExpr NullExpr) initialTypeEnv == Ok BoolType);
    assert "null inequality"
      (checkExpr (BinOpExpr NeqOp NullExpr NullExpr) initialTypeEnv == Ok BoolType);
    assert "reject subtraction on strings"
      (checkExpr (BinOpExpr SubOp (StringExpr "a") (StringExpr "b")) initialTypeEnv
        == Err "unsupported binary operator for operand types");
    assert "reject arithmetic on booleans"
      (checkExpr (BinOpExpr AddOp (BoolExpr true) (BoolExpr false)) initialTypeEnv
        == Err "unsupported binary operator for operand types");
    assert "reject arithmetic on null"
      (checkExpr (BinOpExpr AddOp NullExpr NullExpr) initialTypeEnv
        == Err "unsupported binary operator for operand types")
  };

let testBinOpErrors: IO Unit =
  let identity = FnExpr [{name = "x", typ = NumberType}] NumberType (VarExpr "x") in
  do (bindIO) {
    assert "reject mixed operand types"
      (checkExpr (BinOpExpr AddOp (NumberExpr 1.0) (BoolExpr true)) initialTypeEnv
        == Err "bad operand types for binary operator");
    assert "equality requires matching primitive types"
      (checkExpr (BinOpExpr EqOp (NumberExpr 1.0) (StringExpr "1")) initialTypeEnv
        == Err "bad operand types for binary operator");
    assert "reject record equality"
      (checkExpr (BinOpExpr EqOp (RecordExpr []) (RecordExpr [])) initialTypeEnv
        == Err "bad operand types for binary operator");
    assert "reject function equality"
      (checkExpr (BinOpExpr EqOp identity identity) initialTypeEnv
        == Err "bad operand types for binary operator");
    assert "report the left operand error first"
      (checkExpr (BinOpExpr AddOp (VarExpr "leftMissing") (VarExpr "rightMissing")) initialTypeEnv
        == Err "unbound variable: leftMissing");
    assert "report a right operand error before comparing types"
      (checkExpr (BinOpExpr AddOp NullExpr (VarExpr "missing")) initialTypeEnv
        == Err "unbound variable: missing");
    assert "false && still checks the right operand"
      (checkExpr (BinOpExpr AndOp (BoolExpr false) (VarExpr "missing")) initialTypeEnv
        == Err "unbound variable: missing");
    assert "true || still checks the right operand"
      (checkExpr (BinOpExpr OrOp (BoolExpr true) (VarExpr "missing")) initialTypeEnv
        == Err "unbound variable: missing")
  };

let testFnExpr: IO Unit =
  let params = [{name = "x", typ = NumberType}, {name = "flag", typ = BoolType}] in
  let identity = FnExpr [{name = "x", typ = NumberType}] NumberType (VarExpr "x") in
  let identityType = FunctionType [{name = "x", typ = NumberType}] NumberType in
  let envWithOuterX = [extendScope emptyScope "x" StringType] in
  let returnRecordType = RecordType [
    {name = "count", typ = NumberType}, {name = "active", typ = BoolType}
  ] in
  let reorderedBody = RecordExpr [
    {name = "active", expr = BoolExpr true}, {name = "count", expr = NumberExpr 1.0}
  ] in
  do (bindIO) {
    assert "zero-parameter function"
      (checkExpr (FnExpr [] NumberType (NumberExpr 1.0)) initialTypeEnv
        == Ok (FunctionType [] NumberType));
    assert "identity function"
      (checkExpr identity initialTypeEnv == Ok identityType);
    assert "preserve parameter names and order"
      (checkExpr (FnExpr params BoolType (VarExpr "flag")) initialTypeEnv
        == Ok (FunctionType params BoolType));
    assert "function captures an outer variable"
      (checkExpr (FnExpr [] StringType (VarExpr "x")) envWithOuterX
        == Ok (FunctionType [] StringType));
    assert "parameter shadows an outer variable of another type"
      (checkExpr identity envWithOuterX == Ok identityType);
    assert "function parameters stay inside the function"
      (checkExpr (RecordExpr [
        {name = "f", expr = identity}, {name = "outside", expr = VarExpr "x"}
      ]) initialTypeEnv == Err "unbound variable: x");
    assert "reject duplicate parameter names"
      (checkExpr (FnExpr [{name = "x", typ = NumberType}, {name = "x", typ = NumberType}]
        NumberType (VarExpr "x")) initialTypeEnv == Err "duplicate parameter names");
    assert "reject nonadjacent duplicate parameter names"
      (checkExpr (FnExpr [
        {name = "x", typ = NumberType}, {name = "y", typ = StringType}, {name = "x", typ = BoolType}
      ] BoolType (VarExpr "x")) initialTypeEnv == Err "duplicate parameter names");
    assert "reject a mismatched return type"
      (checkExpr (FnExpr [] BoolType (NumberExpr 1.0)) initialTypeEnv
        == Err "expected boolean, got number");
    assert "return records may reorder fields and preserve the annotation"
      (checkExpr (FnExpr [] returnRecordType reorderedBody) initialTypeEnv
        == Ok (FunctionType [] returnRecordType));
    assert "function body errors propagate"
      (checkExpr (FnExpr [] NumberType (VarExpr "missing")) initialTypeEnv
        == Err "unbound variable: missing")
  };

let testFnTypeValidation: IO Unit =
  let duplicateRecordType = RecordType [
    {name = "x", typ = NumberType}, {name = "x", typ = BoolType}
  ] in
  let duplicateFunctionType = FunctionType [
    {name = "x", typ = NumberType}, {name = "x", typ = BoolType}
  ] NumberType in
  let nestedCallbackType = RecordType [{name = "callback", typ = duplicateFunctionType}] in
  do (bindIO) {
    assert "validate an unused record parameter"
      (checkExpr (FnExpr [{name = "unused", typ = duplicateRecordType}] NullType NullExpr)
        initialTypeEnv == Err "duplicate record field names");
    assert "validate record fields inside a function return type"
      (checkExpr (FnExpr [] (FunctionType [] duplicateRecordType) (VarExpr "missing"))
        initialTypeEnv == Err "duplicate record field names");
    assert "reject duplicate names in a function parameter annotation"
      (checkExpr (FnExpr [{name = "callback", typ = duplicateFunctionType}] NullType NullExpr)
        initialTypeEnv == Err "duplicate function type parameter name");
    assert "validate the return annotation before the body"
      (checkExpr (FnExpr [] duplicateFunctionType (VarExpr "missing")) initialTypeEnv
        == Err "duplicate function type parameter name");
    assert "validate a function type nested inside a record annotation"
      (checkExpr (FnExpr [{name = "unused", typ = nestedCallbackType}] NullType NullExpr)
        initialTypeEnv == Err "duplicate function type parameter name");
    assert "duplicate function parameters precede annotation validation"
      (checkExpr (FnExpr [
        {name = "same", typ = duplicateRecordType}, {name = "same", typ = NumberType}
      ] NullType NullExpr) initialTypeEnv == Err "duplicate parameter names")
  };

let testAppExpr: IO Unit =
  let identity = FnExpr [{name = "value", typ = NumberType}] NumberType (VarExpr "value") in
  let callbackType = FunctionType [{name = "argument", typ = NumberType}] NumberType in
  let applyCallback = FnExpr [{name = "callback", typ = callbackType}] NumberType
    (AppExpr (VarExpr "callback") [NumberExpr 1.0]) in
  let twoParams = FnExpr [{name = "n", typ = NumberType}, {name = "text", typ = StringType}]
    BoolType (BoolExpr true) in
  let envWithBooleanValue = [extendScope emptyScope "value" BoolType] in
  do (bindIO) {
    assert "apply an identity function"
      (checkExpr (AppExpr identity [NumberExpr 2.0]) initialTypeEnv == Ok NumberType);
    assert "apply a zero-parameter function"
      (checkExpr (AppExpr (FnExpr [] StringType (StringExpr "hello")) []) initialTypeEnv
        == Ok StringType);
    assert "function arguments may use different parameter names"
      (checkExpr (AppExpr applyCallback [identity]) initialTypeEnv == Ok NumberType);
    assert "arguments use the caller scope"
      (checkExpr (AppExpr identity [VarExpr "value"]) envWithBooleanValue
        == Err "expected number, got boolean");
    assert "callee parameters do not bind argument variables"
      (checkExpr (AppExpr identity [VarExpr "value"]) initialTypeEnv
        == Err "unbound variable: value");
    assert "reject a non-function before checking its arguments"
      (checkExpr (AppExpr (NumberExpr 1.0) [VarExpr "missing"]) initialTypeEnv
        == Err "application requires a function");
    assert "report function errors before argument errors"
      (checkExpr (AppExpr (VarExpr "missingFunction") [VarExpr "missingArgument"])
        initialTypeEnv == Err "unbound variable: missingFunction");
    assert "reject too few arguments"
      (checkExpr (AppExpr identity []) initialTypeEnv
        == Err "number of arguments do not match number of parameters");
    assert "reject too many arguments before checking them"
      (checkExpr (AppExpr identity [NumberExpr 1.0, VarExpr "missing"]) initialTypeEnv
        == Err "number of arguments do not match number of parameters");
    assert "reject an argument of the wrong type"
      (checkExpr (AppExpr identity [BoolExpr true]) initialTypeEnv
        == Err "expected number, got boolean");
    assert "check later argument types"
      (checkExpr (AppExpr twoParams [NumberExpr 1.0, BoolExpr true]) initialTypeEnv
        == Err "expected string, got boolean");
    assert "an earlier type mismatch precedes a later argument error"
      (checkExpr (AppExpr twoParams [BoolExpr true, VarExpr "missing"]) initialTypeEnv
        == Err "expected number, got boolean")
  };

let testRecordArguments: IO Unit =
  let recordType = RecordType [
    {name = "count", typ = NumberType}, {name = "active", typ = BoolType}
  ] in
  let readCount = FnExpr [{name = "record", typ = recordType}] NumberType
    (FieldExpr (VarExpr "record") "count") in
  let reorderedRecord = RecordExpr [
    {name = "active", expr = BoolExpr true}, {name = "count", expr = NumberExpr 1.0}
  ] in
  do (bindIO) {
    assert "record arguments may reorder fields"
      (checkExpr (AppExpr readCount [reorderedRecord]) initialTypeEnv == Ok NumberType);
    assert "record arguments must contain the declared fields"
      (checkExpr (AppExpr readCount [RecordExpr []]) initialTypeEnv
        == Err "expected {count: number, active: boolean}, got {}")
  };

let testRecordExpr: IO Unit =
  let fields = RecordExpr [
    {name = "count", expr = NumberExpr 1.0}, {name = "active", expr = BoolExpr true}
  ] in
  let fieldsType = RecordType [
    {name = "count", typ = NumberType}, {name = "active", typ = BoolType}
  ] in
  let envWithOuterX = [extendScope emptyScope "x" StringType] in
  let usesOuterX = RecordExpr [
    {name = "x", expr = NumberExpr 1.0}, {name = "copy", expr = VarExpr "x"}
  ] in
  do (bindIO) {
    assert "empty record"
      (checkExpr (RecordExpr []) initialTypeEnv == Ok (RecordType []));
    assert "record retains field names, types, and order"
      (checkExpr fields initialTypeEnv == Ok fieldsType);
    assert "record fields do not shadow outer variables"
      (checkExpr usesOuterX envWithOuterX
        == Ok (RecordType [{name = "x", typ = NumberType}, {name = "copy", typ = StringType}]));
    assert "record fields do not bind sibling expressions"
      (checkExpr usesOuterX initialTypeEnv == Err "unbound variable: x");
    assert "reject duplicate fields before checking their expressions"
      (checkExpr (RecordExpr [
        {name = "x", expr = VarExpr "missing"}, {name = "x", expr = BoolExpr true}
      ]) initialTypeEnv == Err "duplicate record field names");
    assert "reject nonadjacent duplicate fields"
      (checkExpr (RecordExpr [
        {name = "x", expr = NumberExpr 1.0}, {name = "y", expr = NullExpr},
        {name = "x", expr = BoolExpr true}
      ]) initialTypeEnv == Err "duplicate record field names");
    assert "later record field errors propagate"
      (checkExpr (RecordExpr [
        {name = "ok", expr = NumberExpr 1.0}, {name = "bad", expr = VarExpr "missing"}
      ]) initialTypeEnv == Err "unbound variable: missing");
    assert "report the first record field error"
      (checkExpr (RecordExpr [
        {name = "first", expr = VarExpr "firstMissing"},
        {name = "last", expr = VarExpr "lastMissing"}
      ]) initialTypeEnv == Err "unbound variable: firstMissing")
  };

let testFieldExpr: IO Unit =
  let record = RecordExpr [
    {name = "count", expr = NumberExpr 1.0}, {name = "active", expr = BoolExpr true}
  ] in
  let nestedRecord = RecordExpr [{name = "inner", expr = record}] in
  let invalidRecord = RecordExpr [
    {name = "count", expr = NumberExpr 1.0}, {name = "bad", expr = VarExpr "missing"}
  ] in
  do (bindIO) {
    assert "read the first field"
      (checkExpr (FieldExpr record "count") initialTypeEnv == Ok NumberType);
    assert "read a later field"
      (checkExpr (FieldExpr record "active") initialTypeEnv == Ok BoolType);
    assert "read a nested field"
      (checkExpr (FieldExpr (FieldExpr nestedRecord "inner") "active") initialTypeEnv == Ok BoolType);
    assert "reject a missing field"
      (checkExpr (FieldExpr record "missing") initialTypeEnv
        == Err "record has no field named missing");
    assert "field names are case sensitive"
      (checkExpr (FieldExpr record "Count") initialTypeEnv
        == Err "record has no field named Count");
    assert "reject field access on a non-record"
      (checkExpr (FieldExpr (NumberExpr 1.0) "count") initialTypeEnv
        == Err "accessing field on a non-record");
    assert "record expression errors propagate"
      (checkExpr (FieldExpr (VarExpr "missing") "count") initialTypeEnv
        == Err "unbound variable: missing");
    assert "check every field before selecting one"
      (checkExpr (FieldExpr invalidRecord "count") initialTypeEnv
        == Err "unbound variable: missing")
  };

let testNestedExpr: IO Unit =
  let returnedType = FunctionType [{name = "documented", typ = NumberType}] NumberType in
  let addToBase = FnExpr [{name = "amount", typ = NumberType}] NumberType
    (BinOpExpr AddOp (VarExpr "base") (VarExpr "amount")) in
  let makeAdder = FnExpr [{name = "base", typ = NumberType}] returnedType addToBase in
  let functions = RecordExpr [{name = "makeAdder", expr = makeAdder}] in
  let addFive = AppExpr (FieldExpr functions "makeAdder") [NumberExpr 5.0] in
  do (bindIO) {
    assert "returned function preserves its annotation despite renamed parameters"
      (checkExpr addFive initialTypeEnv == Ok returnedType);
    assert "call a returned closure stored in a record"
      (checkExpr (AppExpr addFive [NumberExpr 2.0]) initialTypeEnv == Ok NumberType)
  };

let testCheckExpr: IO Unit =
  do (bindIO) {
    testLiteralExpr;
    testVarExpr;
    testAssignExpr;
    testCompositeAssignments;
    testUnaryOpExpr;
    testNumberOperators;
    testOtherOperators;
    testBinOpErrors;
    testFnExpr;
    testFnTypeValidation;
    testAppExpr;
    testRecordArguments;
    testRecordExpr;
    testFieldExpr;
    testNestedExpr;
    outputLnIO "✅ All passing for checkExpr tests"
  };
