include "common.kl";
include "syntax.kl";


letrec inArr elem arr =
  match arr {
  
    [] => 
      false;

    f :: rest => 
      if f == elem then true else inArr elem rest;
    
  };

letrec allUnique records curr =
  match records {
    [] => 
      true;

    first :: rest =>
      if inArr first.name curr then
        false
      else
       allUnique rest (first.name :: curr); 
  };

# emptyContext :: String -> Option Type
let emptyScope =
  fn name =>
    None;

# extendContext
#   :: (String -> Option Type)
#   -> String
#   -> Type
#   -> (String -> Option Type)
let extendScope scope name typ =
  fn query => 
    if query == name then
      Some typ
    else
     scope query;

letrec addBindings scope bindings =
  match bindings {
    [] => scope;

    first :: rest =>
      addBindings (extendScope scope first.name first.typ) rest;
    
  };

# typeEquals :: Type -> Type -> Bool
letrec typeEquals left right =
  match left, right {
    NumberType, NumberType =>
      true;

    BoolType, BoolType =>
      true;

    StringType, StringType =>
      true;

    NullType, NullType =>
      true;

    FunctionType lParams lRet, FunctionType rParams rRet =>
      letrec paramsMatch left right =
        match left, right {
          [], [] => true;
    
          lParam :: lRest, rParam :: rRest =>
            (typeEquals lParam rParam) && (paramsMatch lRest rRest);
    
          _, _ => false;
        }
      in
        (typeEquals lRet rRet) && (paramsMatch lParams rParams);

    RecordType lRecord, RecordType rRecord =>
      if length lRecord != length rRecord then
        false
      else
        let rightScope = addBindings emptyScope rRecord in
        letrec fieldsMatch fields =
          match fields {
            [] => true;
    
            field :: rest =>
              match rightScope field.name {
                None => false;
                Some rightType =>
                  (typeEquals field.typ rightType) && (fieldsMatch rest);
              };
          }
        in 
          fieldsMatch lRecord;
        
    _, _ =>
      false;
  };


let pushScope typeEnv =
  emptyScope :: typeEnv;

# localScope ::= List (String -> Option Type) -> (String -> Option Type)
let localScope typeEnv =
  match typeEnv {
    scope :: rest => scope;
    [] => emptyScope;
  };

// then to query:
# match (localScope typeEnv) name {
#   Some _ => ...;  
#   None => ...;
# };

let initialTypeEnv = [emptyScope];

letrec lookup name typeEnv =
  match typeEnv {
    [] =>
      Err (str_concat "unbound variable: " name);

    scope :: rest =>
      match scope name {
        Some typ => Ok typ;
        None => lookup name rest;
      };
  };


# checkExpr    : Expr -> TypeEnv -> Result Type TypeError
letrec checkExpr expr typeEnv =
  // check for uniquness aswell of field names and paramters here before continuing. 

  match expr {

    NumberExpr _ =>
      Ok NumberType;
      
    BoolExpr _ =>
      Ok BoolType;
    
    StringExpr _ =>
      Ok StringType;
    
    NullExpr =>
      Ok NullType;

    VarExpr name =>
      lookup name typeEnv;

    VarExpr name =>
      lookup name typeEnv;

    AssignExpr name e =>
      match checkExpr e typeEnv {
        Ok typExpr =>
          match lookup name typeEnv {
            Ok typVar =>
              if typeEquals typVar typExpr then
                Ok typVar
              else
                Err "assignment type mismatch";
    
            Err err =>
              Err err;
          };
    
        Err err =>
          Err err;
      };

    UnaryOpExpr op e =>
      match checkExpr e typeEnv {
        Ok typ =>
          match op, typ {
            NegOp, NumberType => 
              Ok NumberType;
            NotOp, BoolType =>
              Ok BoolType;
            _,_ =>
              Err "bad operand type for unary operator";
              // maybe str_concat with what unary operator it erred on, just add more cases 
          };

        Err err => 
          Err err;
        
      };

    BinOpExpr op left right =>
      let checkedLeft = checkExpr left typeEnv in
      let checkedRight = checkExpr right typeEnv in

      match checkedLeft, checkedRight {
        Ok leftType, Ok rightType =>
        
          match leftType, rightType {
            NumberType, NumberType =>
              match op {
                AddOp => Ok NumberType; // T-Arith
                SubOp => Ok NumberType; // T-Arith
                MulOp => Ok NumberType; // T-Arith
                DivOp => Ok NumberType; // T-Arith
                LtOp => Ok BoolType; // T-Compare
                LeOp => Ok BoolType; // T-Compare
                GtOp => Ok BoolType; // T-Compare
                GeOp => Ok BoolType; // T-Compare
                EqOp => Ok BoolType; // T-Equal
                NeqOp => Ok BoolType; // T-Equal
                _ => Err "unsupported binary operator for operand types";
              };
            
            StringType, StringType =>
              match op {
              // assume parser makes "+" concat for now
              AddOp => Ok StringType; // T-Concat
              EqOp => Ok BoolType; // T-Equal
              NeqOp => Ok BoolType; // T-Equal
              _ => Err "unsupported binary operator for operand types";
              };
              
            BoolType, BoolType =>
              match op {
                AndOp => Ok BoolType; // T-Logic
                OrOp => Ok BoolType; // T-Logic
                EqOp => Ok BoolType; // T-Equal
                NeqOp => Ok BoolType; // T-Equal
                _ => Err "unsupported binary operator for operand types";
              };
              
            NullType, NullType =>
              match op {
                EqOp => Ok BoolType; // T-Equal
                NeqOp => Ok BoolType; // T-Equal
                _ => Err "unsupported binary operator for operand types";
              };

            _,_ =>
              Err "bad operand types for binary operator";
             
         };
          
        Err err, _ => Err err;
        _, Err err => Err err;
        
      };

    FnExpr params returnType body =>
      // uniqueness check
      if not (allUnique params []) then
        Err "duplicate parameter names"
      else
        let newScope = addBindings emptyScope params in
        let newEnv = newScope :: typeEnv in

        match checkExpr body newEnv {
          Ok actualBodyType =>
            if typeEquals returnType actualBodyType then
              Ok (FunctionType (map (fn x => x.typ)  params) returnType)
            else
              Err (typeMismatch returnType actualBodyType);
          Err err => Err err;
        };
        
    AppExpr function arguments =>
      match checkExpr function typeEnv {
        Err err => Err err;
    
        Ok (FunctionType paramTypes returnType) =>
          let arityError = "number of arguments does not match number of parameters" in
          letrec checkArgs args params =
            match args, params {
              [], [] =>
                Ok returnType;
    
              arg :: restArgs, expected :: restParams =>
                match checkExpr arg typeEnv {
                  Err err => Err err;
    
                  Ok actual =>
                    if typeEquals actual expected then
                      checkArgs restArgs restParams
                    else
                      Err (typeMismatch expected actual); 
                };
    
              _, _ => Err arityError;
            }
          in
            if length arguments != length paramTypes then
              Err arityError
            else
              checkArgs arguments paramTypes;
      
        Ok _ => Err "application requires a function";
      };

    RecordExpr fields =>
      if not (allUnique fields []) then
        Err "duplicate record field names"
      else
        letrec getTypedFields fields =
          match fields {
            [] => Ok [];

            field :: rest =>
              match checkExpr field.expr typeEnv {
                Ok typ =>
                  match getTypedFields rest {
                    Ok typedRest =>
                      Ok ({name = field.name, typ = typ} :: typedRest);
                    Err err => 
                      Err err;
                      
                  };
                Err err => Err err; 
              };
          } in 
          match getTypedFields fields {
            Ok typedFields => Ok (RecordType typedFields);
            Err err => Err err; 
          };

    FieldExpr expr targetFieldName =>
      match checkExpr expr typeEnv {
        Ok (RecordType typedFields) =>
          letrec findField fields =
            match fields {
              [] =>
                Err (str_concat "record has no field named " targetFieldName);
    
              field :: rest =>
                if field.name == targetFieldName then
                  Ok field.typ
                else
                  findField rest;
            }
          in findField typedFields;
    
        Ok _ =>
          Err "accessing field on a non-record";
    
        Err err =>
          Err err;
      };
    
    _ => Err "invalid constructor type"; 
  };

