include "common.kl";
include "syntax.kl";

# inArr :: a -> [a] -> Bool
letrec inArr elem arr =
  match arr {
  
    [] => 
      false;

    f :: rest => 
      if f == elem then true else inArr elem rest;
    
  };

# allUnique :: [{name: String, typ: Type}] -> [String] -> Bool
letrec allUnique records curr =
  match records {
    [] => 
      true;

    first :: rest =>
      if inArr first.name curr then
        false
      else
       allUnique rest (first.name :: curr); 
  };

# emptyContext :: String -> Option Type
let emptyScope =
  fn name =>
    None;

# extendContext
#   :: (String -> Option Type)
#   -> String
#   -> Type
#   -> (String -> Option Type)
let extendScope scope name typ =
  fn query => 
    if query == name then
      Some typ
    else
     scope query;

// helper to add {name: string, typ: Type} bindings into a scope using extendScope
# addBindings :: (String -> Option Type) -> [{name: string, typ: Type}] -> (String -> Option Type)
letrec addBindings scope bindings =
  match bindings {
    [] => scope;

    first :: rest =>
      addBindings (extendScope scope first.name first.typ) rest;
    
  };

# typeEquals :: Type -> Type -> Bool
letrec typeEquals left right =
  match left, right {
    NumberType, NumberType =>
      true;

    BoolType, BoolType =>
      true;

    StringType, StringType =>
      true;

    NullType, NullType =>
      true;

    FunctionType lParams lRet, FunctionType rParams rRet =>
      // helper to recursively match left and right types in order
      # paramsMatch :: [Type] -> [Type] -> Bool
      letrec paramsMatch left right =
        match left, right {
          [], [] => true;
    
          lParam :: lRest, rParam :: rRest =>
            (typeEquals lParam rParam) && (paramsMatch lRest rRest);
    
          _, _ => false;
        }
      in
        (typeEquals lRet rRet) && (paramsMatch lParams rParams);

    RecordType lRecord, RecordType rRecord =>
      if length lRecord != length rRecord then
        false
      else
        let rightScope = addBindings emptyScope rRecord in
        // Unlike paramsMatch helper in FunctionType, since fields can be in any order
        // each type in left must be checked against every type in right.
        // Do this by adding all bindings into an emptyScope, then for each name
        // in left, check if it exists in the new scope (and then check if equal). 
        # fieldsMatch :: [{name: String, typ: Type}] -> Bool
        letrec fieldsMatch fields =
          match fields {
            [] => true;
    
            field :: rest =>
              match rightScope field.name {
                None => false;
                Some rightType =>
                  (typeEquals field.typ rightType) && (fieldsMatch rest);
              };
          }
        in 
          fieldsMatch lRecord;
        
    _, _ =>
      false;
  };

# pushScope :: [(String -> Option Type)] -> [(String -> Option Type)]
let pushScope typeEnv =
  emptyScope :: typeEnv;

# localScope ::  [(String -> Option Type)] -> (String -> Option Type)
let localScope typeEnv =
  match typeEnv {
    scope :: rest => scope;
    [] => emptyScope;
  };

# [(String -> Option Type)]
let initialTypeEnv = [emptyScope];

// helper that goes through the whole typeEnv (i.e. stack of scopes)
// and check if name is bound
# lookup :: String -> [(String -> Option Type)] -> Result Type TypeError
letrec lookup name typeEnv =
  match typeEnv {
    [] =>
      Err (str_concat "unbound variable: " name);

    scope :: rest =>
      match scope name {
        Some typ => Ok typ;
        None => lookup name rest;
      };
  };

// recursively validates function parameter/return types and record field types
# validateType : Type -> Result Unit TypeError
letrec validateType typ =
  // helper to go through list of Types
  # validateTypes :: [Types] -> Result Unit TypeError
  letrec validateTypes types =
    match types {
      [] => Ok unit;

      first :: rest =>
        match validateType first {
          Ok _ => validateTypes rest;
          Err err => Err err;
        };
    } in

  match typ {
    NumberType => Ok unit;
    BoolType => Ok unit;
    StringType => Ok unit;
    NullType => Ok unit;
    FunctionType paramTypes retType =>
      match validateTypes paramTypes {
        Ok _ => validateType retType;
        Err err => Err err;
      };
    RecordType fieldTypes =>
      if not (allUnique fieldTypes []) then
        Err "duplicate record field names"
      else
        validateTypes (map (fn field => field.typ) fieldTypes);
  };


# checkExpr :: Expr -> TypeEnv -> Result Type TypeError
letrec checkExpr expr typeEnv =

  match expr {

    NumberExpr _ =>
      Ok NumberType;
      
    BoolExpr _ =>
      Ok BoolType;
    
    StringExpr _ =>
      Ok StringType;
    
    NullExpr =>
      Ok NullType;

    VarExpr name =>
      lookup name typeEnv;

    VarExpr name =>
      lookup name typeEnv;

    AssignExpr name e =>
      match checkExpr e typeEnv {
        Ok typExpr =>
          match lookup name typeEnv {
            Ok typVar =>
              if typeEquals typVar typExpr then
                Ok typVar
              else
                Err "assignment type mismatch";
    
            Err err =>
              Err err;
          };
    
        Err err =>
          Err err;
      };

    UnaryOpExpr op e =>
      match checkExpr e typeEnv {
        Ok typ =>
          match op, typ {
            NegOp, NumberType => 
              Ok NumberType;
            NotOp, BoolType =>
              Ok BoolType;
            _,_ =>
              Err "bad operand type for unary operator";
              // maybe str_concat with what unary operator it erred on, just add more cases 
          };

        Err err => 
          Err err;
        
      };

    BinOpExpr op left right =>
      let checkedLeft = checkExpr left typeEnv in
      let checkedRight = checkExpr right typeEnv in

      match checkedLeft, checkedRight {
        Ok leftType, Ok rightType =>
        
          match leftType, rightType {
            NumberType, NumberType =>
              match op {
                AddOp => Ok NumberType; // T-Arith
                SubOp => Ok NumberType; // T-Arith
                MulOp => Ok NumberType; // T-Arith
                DivOp => Ok NumberType; // T-Arith
                LtOp => Ok BoolType; // T-Compare
                LeOp => Ok BoolType; // T-Compare
                GtOp => Ok BoolType; // T-Compare
                GeOp => Ok BoolType; // T-Compare
                EqOp => Ok BoolType; // T-Equal
                NeqOp => Ok BoolType; // T-Equal
                _ => Err "unsupported binary operator for operand types";
              };
            
            StringType, StringType =>
              match op {
              // assume parser makes "+" concat for now
              AddOp => Ok StringType; // T-Concat
              EqOp => Ok BoolType; // T-Equal
              NeqOp => Ok BoolType; // T-Equal
              _ => Err "unsupported binary operator for operand types";
              };
              
            BoolType, BoolType =>
              match op {
                AndOp => Ok BoolType; // T-Logic
                OrOp => Ok BoolType; // T-Logic
                EqOp => Ok BoolType; // T-Equal
                NeqOp => Ok BoolType; // T-Equal
                _ => Err "unsupported binary operator for operand types";
              };
              
            NullType, NullType =>
              match op {
                EqOp => Ok BoolType; // T-Equal
                NeqOp => Ok BoolType; // T-Equal
                _ => Err "unsupported binary operator for operand types";
              };

            _,_ =>
              Err "bad operand types for binary operator";
             
         };
          
        Err err, _ => Err err;
        _, Err err => Err err;
        
      };

    FnExpr params returnType body =>
      // uniqueness check on params
      if not (allUnique params []) then
        Err "duplicate parameter names"
      else
        let fnType = FunctionType (map (fn p => p.typ) params) returnType in
        // recursively check params using validateType
        match validateType fnType {
          Err err => Err err;
          Ok _ => 
            let newScope = addBindings emptyScope params in
            let newEnv = newScope :: typeEnv in
    
            match checkExpr body newEnv {
              Ok actualBodyType =>
                if typeEquals returnType actualBodyType then
                  Ok fnType
                else
                  Err (typeMismatch returnType actualBodyType);
              Err err => Err err;
            };
        };
        
    AppExpr function arguments =>
      match checkExpr function typeEnv {
        Err err => Err err;
    
        Ok (FunctionType paramTypes returnType) =>
          let arityError = "number of arguments do not match number of parameters" in
          // checks all expressions in arguments if their resulting type matches expected types
          # checkArgs :: [Expr] -> [{name: String, typ: Type}] -> Result Type TypeError
          letrec checkArgs args params =
            match args, params {
              [], [] =>
                Ok returnType;
    
              arg :: restArgs, expected :: restParams =>
                match checkExpr arg typeEnv {
                  Err err => Err err;
    
                  Ok actual =>
                    if typeEquals actual expected then
                      checkArgs restArgs restParams
                    else
                      Err (typeMismatch expected actual); 
                };
    
              _, _ => Err arityError;
            }
          in
            if length arguments != length paramTypes then
              Err arityError
            else
              checkArgs arguments paramTypes;
      
        Ok _ => Err "application requires a function";
      };

    RecordExpr fields =>
      if not (allUnique fields []) then
        Err "duplicate record field names"
      else
        // getting the type of each expr in fields while reconstructing the list in that order
        # getTypedFields :: [{name: String, expr: Expr}] -> Result ([{name: String, type: Type}]) TypeError
        letrec getTypedFields fields =
          match fields {
            [] => Ok [];

            field :: rest =>
              match checkExpr field.expr typeEnv {
                Ok typ =>
                  match getTypedFields rest {
                    Ok typedRest =>
                      Ok ({name = field.name, typ = typ} :: typedRest);
                    Err err => 
                      Err err;
                      
                  };
                Err err => Err err; 
              };
          } in 
          match getTypedFields fields {
            Ok typedFields => Ok (RecordType typedFields);
            Err err => Err err; 
          };

    FieldExpr expr targetFieldName =>
      match checkExpr expr typeEnv {
        Ok (RecordType typedFields) =>
          // checks if record has name targetFieldName in typedFields
          # findField :: [{name: String, expr: Expr}] -> Result Type TypeError
          letrec findField fields =
            match fields {
              [] =>
                Err (str_concat "record has no field named " targetFieldName);
    
              field :: rest =>
                if field.name == targetFieldName then
                  Ok field.typ
                else
                  findField rest;
            }
          in findField typedFields;
    
        Ok _ =>
          Err "accessing field on a non-record";
    
        Err err =>
          Err err;
      };
    
    _ => Err "invalid constructor type"; 
  };

# checkStmt :: Stmt -> TypeEnv -> Result TypeEnv TypeError
letrec checkStmt stmt typeEnv =
  
  // for T-SeqEmpty and T-SeqCons
  // also a helper function that checks if each stmt in the list 
  // is valid and passes the typEnv on the next stmt
  # checkSeq [Stmt] -> [(String -> Option Type)] -> Result TypeEnv TypeError
  letrec checkSeq stmts typeEnv =
    match stmts {
      [] => Ok typeEnv;
  
      first :: rest =>
        match checkStmt first typeEnv {
          Ok nextEnv => checkSeq rest nextEnv;
          Err err => Err err;
        };
    } in 

  match stmt {
    LetStmt name annotation expr =>
      match checkExpr expr typeEnv {
        Ok actual =>
          match typeEnv {
            [] => Err "type environment has no current scope";
    
            innerScope :: outerScopes =>
              match innerScope name {
                Some _ =>
                  Err (str_concat "duplicate declaration: " name);
    
                None =>
                  let newScope = extendScope innerScope name actual in
                  let newEnv = newScope :: outerScopes in
                  match annotation {
                    None => Ok newEnv;
                    Some expected =>
                      match validateType expected {
                        Ok _ =>
                          if typeEquals actual expected then
                            Ok newEnv
                          else
                            Err (typeMismatch expected actual);
                        Err err => Err err;
                      };
                  };
              };
          };
          Err err => Err err;
      };

    ExprStmt expr =>
      match checkExpr expr typeEnv {
        Ok _ => Ok typeEnv;
        Err err => Err err;
      };

    BlockStmt stmts =>
      match checkSeq stmts (pushScope typeEnv){
        Ok _ => Ok typeEnv;
        Err err => Err err;  
      };
      
    IfStmt expr thenBlock optionElseBlock  =>
      match checkExpr expr typeEnv {
        Ok actual =>
          if not (typeEquals BoolType actual) then
            Err (typeMismatch BoolType actual)
          else
            match checkStmt (BlockStmt thenBlock) typeEnv {
              Ok _ =>
                match optionElseBlock {
                  Some elseBlock =>
                    match checkStmt (BlockStmt elseBlock) typeEnv{
                      Ok _ => Ok typeEnv;
                      Err err => Err err;
                    };
                  None => Ok typeEnv;
                };
              Err err =>
                Err err;
            };
        Err err =>
          Err err;
      };
    
    WhileStmt expr block =>
      match checkExpr expr typeEnv {
      Ok actual =>
        if not (typeEquals BoolType actual) then
          Err (typeMismatch BoolType actual)
        else
          match checkStmt (BlockStmt block) typeEnv {
            Ok _ => Ok typeEnv;
            Err err => Err err;
          };
      Err err =>
        Err err;
      };

    _ => Err "invalid statement type";
  };

# checkProgram :: Program -> Result Unit TypeError
let checkProgram program =
  # checkSeq [Stmt] -> [(String -> Option Type)] -> Result TypeEnv TypeError
  letrec checkSeq stmts typeEnv =
    match stmts {
      [] => Ok typeEnv;
  
      first :: rest =>
        match checkStmt first typeEnv {
          Ok nextEnv => checkSeq rest nextEnv;
          Err err => Err err;
        };
    } in
    
  match checkSeq program initialTypeEnv {
    Ok _ => Ok unit;
    Err err => Err err;
    };

let main = pureIO unit;
