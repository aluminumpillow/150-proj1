include "common.kl";
include "syntax.kl";

#reserving certain words from being used as identifiers, parameter names, or field names

#[helper] list of the 10 reserved words
let reservedWords =
  ["let", "if", "else", "while", "true", "false", "null",
   "number", "boolean", "string"];

#[helper] true if value is in the list xs
let containsString xs value =
  foldLeft (fn found x => found || x == value) false xs;

#[helper] true if name is one of the reserved words
let isReserved name =
  containsString reservedWords name;

#[helper] error type: where parsing failed and why
type alias ParseError = {index: Int, message: String};

#[helper] starting state: whole source, index 0
let initialState source = {src = source, index = 0};

#[helper] runs parser p on a source string
let runParser p source = p (initialState source);

#[helper] builds an error at the current index
let errorAt st message = {index = st.index, message = message};

#[helper] succeeds with value without reading anything
let pureP value =
  fn st => Ok {value = value, state = st};

#[helper] runs p, then the parser chosen by next using p's result
let andThen p next =
  fn st =>
    match p st {
    Err e => Err e;
      Ok r => (next r.value) r.state;
    };

#[helper] runs p and transforms its result with f
let mapP f p =
  andThen p (fn x => pureP (f x));

#[helper] runs p then q, keeps q's result
let keepRight p q =
  andThen p (fn ignored => q);

#[helper] picks the error that got further into the input
let fartherError e1 e2 =
  if e2.index >= e1.index then e2 else e1;

#[helper] tries p; if it fails, tries q from the same spot (backtracking)
let orElse p q =
  fn st =>
    match p st {
      Ok r => Ok r;
      Err e1 =>
        match q st {
          Ok r => Ok r;
          Err e2 => Err (fartherError e1 e2);
        };
    };

#[helper] current character without consuming it (None at end)
let peekChar st =
  if st.index < str_len st.src then
    Some (str_at st.src st.index)
  else
    None;

#[helper] moves the index forward n characters
let advance st n = { src = st.src, index = st.index + n };

#[helper] reads one character if test accepts it
let satisfy test label =
  fn st =>
    match peekChar st {
      None =>
        Err (errorAt st (str_concat "expected " label));

      Some c =>
        if test c then
          Ok { value = c, state = advance st 1 }
        else
          Err (errorAt st (str_concat "expected " label));
    };

#[helper] reads exactly the character c
let charP c =
  satisfy (fn d => d == c) (str_concat "'" (str_concat c "'"));

#[helper] zero or more p; stops if p consumes nothing
letrec many p =
  fn st =>
    match p st {
      Err ignored =>
        Ok { value = [], state = st };

      Ok r =>
        if r.state.index == st.index then
          Ok { value = [], state = st }
        else
          match (many p) r.state {
            Err e => Err e;
            Ok rest => Ok { value = r.value :: rest.value, state = rest.state };
          };
    };

#[helper] one or more p
let many1 p =
  andThen p (fn first =>
    andThen (many p) (fn rest =>
      pureP (first :: rest)));

#[helper] Some result if p matches, otherwise None
let optional p =
  orElse (mapP (fn x => Some x) p) (pureP None);

#skip spaces, tabs, line breaks, and // comments between tokens

#[helper] runs p1 then p2, keeps p1's result
#p1 = first parser, p2 = second parser
let keepLeft p1 p2 =
  andThen p1 (fn x =>
    andThen p2 (fn ignored =>
      pureP x));

#[helper] true for space, tab, \n, \r
let isSpaceChar c =
  c == " " || c == "\t" || c == "\n" || c == "\r";

#[helper] reads exactly the text lit
# lit as in literal/literally lol
let text lit =
  fn st =>
    let n = str_len lit in
    let err = Err (errorAt st (str_concat "expected \"" (str_concat lit "\""))) in
    if st.index + n > str_len st.src then
      err
    else if str_slice st.src st.index (st.index + n) == lit then
      Ok { value = lit, state = advance st n }
    else
      err;

#[helper] reads // up to the end of the line or input
let lineComment =
  andThen (text "//") (fn ignored =>
    andThen (many (satisfy (fn c => c != "\n" && c != "\r") "comment text")) (fn ignored2 =>
      pureP unit));

#[helper] reads one whitespace character
let whitespaceChar =
  mapP (fn ignored => unit) (satisfy isSpaceChar "whitespace");

#skips any whitespace and // comments (possibly none)
let skipSpace =
  mapP (fn ignored => unit) (many (orElse whitespaceChar lineComment));

#runs a token parser, then skips whitespace/comments after it
let lexeme p =
  keepLeft p skipSpace;

#ensuring a number [0-9]+(\.[0-9]+)? and that a leading minus is a separate unary operator

#[helper] true for 0-9
let isDigit c =
  let o = str_ord c in
  o >= 48 && o <= 57;

#[helper] reads one or more digits as a string
let digits1 =
  mapP str_join (many1 (satisfy isDigit "digit"));

#[helper] removes leading zeros from a digit string
#s = string of digits; removes leading zeros but keeps at least one digit
letrec stripLeadingZeros s =
  if str_len s <= 1 then
    s
  else if str_at s 0 == "0" then
    stripLeadingZeros (str_slice s 1 (str_len s))
  else
    s;

#[helper] reads [0-9]+(\.[0-9]+)? as text
#numberText returns the whole-number digits separately so their size can be checked,
#and full = normalized text string_to_float accepts (no leading zeros, always has a ".")
let numberText =
  andThen digits1 (fn whole =>
    andThen (optional (keepRight (charP ".") digits1)) (fn fraction =>
      let w = stripLeadingZeros whole in
      match fraction {
        None => pureP { whole = w, full = str_concat w ".0" };
        Some f => pureP { whole = w, full = str_concat w (str_concat "." f) };
      }));

#[helper] digits of the largest finite float
#digits of the largest finite float (309 digits)
let maxFloatDigits =
  "";

#[helper] true if the whole-number digits fit in a finite float
#whole = digits before the dot (already stripped); true if the number fits in a finite float
let isFiniteWhole whole =
  if str_len whole < str_len maxFloatDigits then
    true
  else if str_len whole > str_len maxFloatDigits then
    false
  else
    str_compare whole maxFloatDigits <= 0;

#parses a number literal into a Float, rejects non-finite, skips trailing space
let numberLiteral =
  lexeme
    (fn st =>
      match numberText st {
        Err e => Err e;

        Ok r =>
          if isFiniteWhole r.value.whole then
            Ok { value = string_to_float r.value.full, state = r.state }
          else
            Err (errorAt st "number literal must be finite");
      });

#identifier: [A-Za-z_][A-Za-z0-9_]* and not a reserved word

#[helper] true for A-Z or a-z
#code = character code of c (65-90 = A-Z, 97-122 = a-z)
let isLetter c =
  let code = str_ord c in
  (code >= 65 && code <= 90) || (code >= 97 && code <= 122);

#[helper] true for a valid first identifier character
let isIdentStart c =
  isLetter c || c == "_";

#[helper] true for a valid later identifier character
let isIdentChar c =
  isIdentStart c || isDigit c;

#[helper] reads [A-Za-z_][A-Za-z0-9_]* without the reserved check
let rawIdentifier =
  andThen (satisfy isIdentStart "identifier") (fn first =>
    andThen (many (satisfy isIdentChar "identifier character")) (fn rest =>
      pureP (str_join (first :: rest))));

#parses an identifier ([A-Za-z_][A-Za-z0-9_]*), rejects reserved words, skips trailing space
let identifier =
  lexeme
    (fn st =>
      match rawIdentifier st {
        Err e => Err e;

        Ok r =>
          if isReserved r.value then
            Err (errorAt st (str_concat "reserved word cannot be an identifier: " r.value))
          else
            Ok r;
      });

#strings: "..." with \" \\ \n \r \t escapes; reject unknown escapes, raw line breaks, unterminated strings

#[helper] maps the character after \ to what it stands for
#c = the character after a backslash
let escapeValue c =
  if c == "\"" then Some "\""
  else if c == "\\" then Some "\\"
  else if c == "n" then Some "\n"
  else if c == "r" then Some "\r"
  else if c == "t" then Some "\t"
  else None;

#[helper] reads string contents up to the closing quote
#acc = decoded text so far, decoded = the character an escape stands for
letrec stringBody st acc =
  match peekChar st {
    None =>
      Err (errorAt st "unterminated string");

    Some c =>
      if c == "\"" then
        Ok { value = acc, state = advance st 1 }
      else if c == "\n" || c == "\r" then
        Err (errorAt st "unescaped line break in string")
      else if c == "\\" then
        match peekChar (advance st 1) {
          None =>
            Err (errorAt st "unterminated string");

          Some e =>
            match escapeValue e {
              None => Err (errorAt st (str_concat "unknown escape \\" e));
              Some decoded => stringBody (advance st 2) (str_concat acc decoded);
            };
        }
      else
        stringBody (advance st 1) (str_concat acc c);
  };

#parses a "..." string literal into its decoded text, skips trailing space
let stringLiteral =
  lexeme
    (andThen (charP "\"") (fn ignored =>
      fn st => stringBody st ""));

#boundaries for keywords and for operators to match their longest spelling

#[helper] succeeds without consuming only if p would fail here
let notFollowedBy p label =
  fn st =>
    match p st {
      Ok ignored => Err (errorAt st (str_concat "unexpected " label));
      Err ignored => Ok { value = unit, state = st };
    };

#parses a keyword that is not followed by an identifier character
let keyword word =
  lexeme
    (keepLeft
      (text word)
      (notFollowedBy (satisfy isIdentChar "identifier character")
        (str_concat "identifier character after keyword " word)));

#parses exact operator/punctuation text
let symbol s =
  lexeme (text s);

#parses a short operator only if it is not the start of a longer one
let symbolExcept s nextChars =
  lexeme
    (keepLeft
      (text s)
      (notFollowedBy (satisfy (fn c => containsString nextChars c) "longer operator")
        (str_concat "longer operator starting with " s)));

#[helper] true if a list of names has a duplicate
#check if a list of names has any duplicates (can be used in 2b & for checking duplicate var names in func)
letrec hasDuplicate names =
  match names {
    [] => false;
    first :: rest =>
      if containsString rest first then
        true
      else
        hasDuplicate rest;
  };

#item 2c: parser combinators for putting smaller parsers together

#[helper] parses one or more values with a separator in between
let sepBy1 p separator =
  andThen p (fn first =>
    andThen (many (keepRight separator p)) (fn rest =>
      pureP (first :: rest)));

#[helper] same as sepBy1 but also allows an empty list
let sepBy p separator =
  orElse (sepBy1 p separator) (pureP []);

#[helper] checks if we have reached the end of the source
let endOfInput =
  fn st =>
    match peekChar st {
      None => Ok {value = unit, state = st};
      Some ignored => Err (errorAt st "expected end of input");
    };

#[helper] returns a parse error with the given message
let failP message =
  fn st => Err (errorAt st message);

#[helper] groups repeated operators from left to right
#e.g. a - b - c becomes (a - b) - c
let chainLeft1 operand op =
  andThen operand (fn first =>
    andThen (many (andThen op (fn combine =>
      mapP (fn rhs => {combine = combine, rhs = rhs}) operand)))
      (fn rest =>
        pureP (foldLeft
          (fn lhs item => item.combine lhs item.rhs)
          first rest)));

#[helper] parses p between ( and )
let parenthesized p =
  keepRight (symbol "(") (keepLeft p (symbol ")"));

#item 2b: parsing MiniTS types

#[helper] parses number, boolean, string, or null as a type
let primitiveType =
  orElse (mapP (fn _ => NumberType) (keyword "number"))
    (orElse (mapP (fn _ => BoolType) (keyword "boolean"))
      (orElse (mapP (fn _ => StringType) (keyword "string"))
        (mapP (fn _ => NullType) (keyword "null"))));

#[helper] reads a parameter name and its type for a function type
let typeParameter parseType =
  andThen identifier (fn name =>
    keepRight (symbol ":")
      (mapP (fn typ => {name = name, typ = typ}) parseType));

#[helper] reads a record field name and its type
let typeField parseType =
  andThen identifier (fn name =>
    keepRight (symbol ":")
      (mapP (fn typ => {name = name, typ = typ}) parseType));

#[helper] parses (x: number) => number as a function type
#checks for repeated parameter names before keeping just their types
let functionTypeParser parseType =
  andThen (parenthesized (sepBy (typeParameter parseType) (symbol ",")))
    (fn params =>
      if hasDuplicate (map (fn param => param.name) params) then
        failP "duplicate function type parameter name"
      else
        keepRight (symbol "=>")
          (mapP (fn ret =>
            FunctionType (map (fn param => param.typ) params) ret)
            parseType));

#[helper] parses record types; the last semicolon is optional
let recordTypeParser parseType =
  keepRight (symbol "{")
    (keepLeft
      (andThen (sepBy (typeField parseType) (symbol ";")) (fn fields =>
        keepRight (optional (symbol ";")) (pureP (RecordType fields))))
      (symbol "}"));

#parses all supported types
#the parser is called with st so recursion only happens when there is input to parse
letrec typeParser st =
  (orElse primitiveType
    (orElse (functionTypeParser typeParser)
      (recordTypeParser typeParser))) st;

#parsing functions and records

#[helper] parses a function parameter with its required type
let valueParameter =
  andThen identifier (fn name =>
    keepRight (symbol ":")
      (mapP (fn typ => {name = name, typ = typ}) typeParser));

#[helper] parses a record field name and its expression
let recordField parseExpr =
  andThen identifier (fn name =>
    keepRight (symbol ":")
      (mapP (fn expr => {name = name, expr = expr}) parseExpr));

#[helper] parses { ... } with comma-separated fields
let recordExpression parseExpr =
  keepRight (symbol "{")
    (keepLeft
      (mapP RecordExpr (sepBy (recordField parseExpr) (symbol ",")))
      (symbol "}"));

#[helper] reads the expression after =>
#if the body is a record, it needs parentheses: => ({ x: 1 })
let arrowBody parseExpr =
  fn st =>
    match peekChar st {
      Some c =>
        if c == "{" then
          Err (errorAt st "parenthesize a record literal returned by an arrow function")
        else
          parseExpr st;
      None => parseExpr st;
    };

#[helper] parses the parameters, return type, and body of an arrow function
let arrowFunction parseExpr =
  andThen (parenthesized (sepBy valueParameter (symbol ",")))
    (fn params =>
      keepRight (symbol ":")
        (andThen typeParser (fn ret =>
          keepRight (symbol "=>")
            (mapP (fn body => FnExpr params ret body)
              (arrowBody parseExpr)))));

#[helper] parses functions, literals, variables, grouped expressions, or records
let primaryExpression parseExpr =
  orElse (arrowFunction parseExpr)
    (orElse (mapP NumberExpr numberLiteral)
      (orElse (mapP StringExpr stringLiteral)
        (orElse (mapP (fn _ => BoolExpr true) (keyword "true"))
          (orElse (mapP (fn _ => BoolExpr false) (keyword "false"))
            (orElse (mapP (fn _ => NullExpr) (keyword "null"))
              (orElse (mapP VarExpr identifier)
                (orElse (parenthesized parseExpr)
                  (recordExpression parseExpr))))))));

#parsing function calls, field access, and operators

#[helper] reads (args) and turns the preceding expression into a function call
let callSuffix parseExpr =
  mapP (fn args => fn target => AppExpr target args)
    (parenthesized (sepBy parseExpr (symbol ",")));

#[helper] reads .field and adds field access to the preceding expression
let fieldSuffix =
  mapP (fn field => fn target => FieldExpr target field)
    (keepRight (symbol ".") identifier);

#[helper] applies calls and field access in the order they appear
#e.g. f(1).x means get x from the result of f(1)
let postfixExpression parseExpr =
  andThen (primaryExpression parseExpr) (fn first =>
    andThen (many (orElse (callSuffix parseExpr) fieldSuffix))
      (fn suffixes =>
        pureP (foldLeft (fn expr apply => apply expr) first suffixes)));

#[helper] parses ! and unary - before the expression they apply to
letrec unaryExpression parseExpr st =
  (orElse
    (andThen
      (orElse (mapP (fn _ => NotOp) (symbolExcept "!" ["="]))
        (mapP (fn _ => NegOp) (symbol "-")))
      (fn op =>
        mapP (fn operand => UnaryOpExpr op operand)
          (unaryExpression parseExpr)))
    (postfixExpression parseExpr)) st;

#[helper] creates a binary operation using the given symbol and AST operator
let binaryOperator spelling constructor =
  mapP (fn _ => fn left => fn right => BinOpExpr constructor left right)
    (symbol spelling);

#[helper] parses * and / before lower-priority operators
let multiplicationExpression parseExpr =
  chainLeft1 (unaryExpression parseExpr)
    (orElse (binaryOperator "*" MulOp)
      (binaryOperator "/" DivOp));

#[helper] parses + and - after multiplication and division
let additionExpression parseExpr =
  chainLeft1 (multiplicationExpression parseExpr)
    (orElse (binaryOperator "+" AddOp)
      (binaryOperator "-" SubOp));

#[helper] parses <, <=, >, and >= comparisons
let comparisonExpression parseExpr =
  chainLeft1 (additionExpression parseExpr)
    (orElse (binaryOperator "<=" LeOp)
      (orElse (binaryOperator ">=" GeOp)
        (orElse
          (mapP (fn _ => fn left => fn right => BinOpExpr LtOp left right)
            (symbolExcept "<" ["="]))
          (mapP (fn _ => fn left => fn right => BinOpExpr GtOp left right)
            (symbolExcept ">" ["="])))));

#[helper] parses === and !== comparisons
let equalityExpression parseExpr =
  chainLeft1 (comparisonExpression parseExpr)
    (orElse (binaryOperator "===" EqOp)
      (binaryOperator "!==" NeqOp));

#[helper] parses expressions joined by &&
let logicalAndExpression parseExpr =
  chainLeft1 (equalityExpression parseExpr)
    (binaryOperator "&&" AndOp);

#[helper] parses expressions joined by ||
let logicalOrExpression parseExpr =
  chainLeft1 (logicalAndExpression parseExpr)
    (binaryOperator "||" OrOp);

#[helper] parses variable assignments with =
#makes sure = is not mistaken for === or =>
let assignmentExpression parseExpr =
  andThen identifier (fn name =>
    keepRight (symbolExcept "=" ["=", ">"])
      (mapP (fn rhs => AssignExpr name rhs) parseExpr));

#parses a MiniTS expression, trying assignment first
#if it is not an assignment, try the other operators instead
letrec expressionParser st =
  (orElse (assignmentExpression expressionParser)
    (logicalOrExpression expressionParser)) st;

#parsing statements and the whole program

#[helper] parses statements inside { and }
let blockParser parseStatement =
  keepRight (symbol "{")
    (keepLeft (many parseStatement) (symbol "}"));

#[helper] parses let declarations with an optional type but a required value
let letStatement parseExpr =
  keepRight (keyword "let")
    (andThen identifier (fn name =>
      andThen (optional (keepRight (symbol ":") typeParser))
        (fn ann =>
          keepRight (symbolExcept "=" ["=", ">"])
            (andThen parseExpr (fn expr =>
              keepRight (symbol ";")
                (pureP (LetStmt name ann expr)))))));

#[helper] parses if blocks and their optional else blocks
let ifStatement parseExpr parseStatement =
  keepRight (keyword "if")
    (andThen (parenthesized parseExpr) (fn condition =>
      andThen (blockParser parseStatement) (fn thenBlock =>
        andThen
          (optional (keepRight (keyword "else")
            (blockParser parseStatement)))
          (fn elseBlock =>
            pureP (IfStmt condition thenBlock elseBlock)))));

#[helper] parses a while condition and its block
let whileStatement parseExpr parseStatement =
  keepRight (keyword "while")
    (andThen (parenthesized parseExpr) (fn condition =>
      mapP (fn body => WhileStmt condition body)
        (blockParser parseStatement)));

#[helper] parses an expression followed by ;
let expressionStatement parseExpr =
  andThen parseExpr (fn expr =>
    keepRight (symbol ";") (pureP (ExprStmt expr)));

#parses a statement, starting with blocks, declarations, if, and while
#a leading { is treated as a block; use ({ x: 1 }); for a record expression
letrec statementParser st =
  match peekChar st {
    Some c =>
      if c == "{" then
        (mapP BlockStmt (blockParser statementParser)) st
      else
        (orElse (letStatement expressionParser)
          (orElse (ifStatement expressionParser statementParser)
            (orElse (whileStatement expressionParser statementParser)
              (expressionStatement expressionParser)))) st;
    None =>
      (orElse (letStatement expressionParser)
        (orElse (ifStatement expressionParser statementParser)
          (orElse (whileStatement expressionParser statementParser)
            (expressionStatement expressionParser)))) st;
  };

#parses all statements, skips spaces/comments, then checks for extra input
let programParser =
  keepRight skipSpace
    (keepLeft (many statementParser)
      (keepRight skipSpace endOfInput));

#main parser: source code -> AST, or ParseError if parsing fails
let parse source =
  match runParser programParser source {
    Ok r => Ok r.value;
    Err e => Err e;
  };
